---
interface Props {
  class?: string;
}

const { class: className = "w-12 h-12" } = Astro.props;
---

<svg 
  xmlns="http://www.w3.org/2000/svg" 
  viewBox="0 0 100 100" 
  class:list={[className, "drop-shadow-[0_2px_4px_rgba(0,0,0,0.08)]"]} 
  fill="none"
>
  <defs>
    <linearGradient id="logo-lightning-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3b82f6" /> <!-- blue-500 -->
      <stop offset="100%" stop-color="#4f46e5" /> <!-- indigo-600 -->
    </linearGradient>
  </defs>
  
  <!-- Silueta de la factura con el rayo fluido integrado en el contorno derecho con 85% de opacidad para efecto de transparencia glassmorphic -->
  <path 
    d="M 30,12 
       L 62,12 
       C 64,12 66,13 67,15 
       L 75,27 
       C 76,29 76,31 75,32 
       L 66,42 
       L 76,42 
       C 78,42 79,44 78,46 
       L 56,76 
       C 55,77 53,78 52,77 
       L 44,70 
       L 44,83 
       C 44,85 42,87 40,87 
       L 26,87 
       C 24,87 22,85 22,83 
       L 22,20 
       C 22,15 26,12 30,12 
       Z" 
    fill="url(#logo-lightning-gradient)" 
    fill-opacity="0.85"
  />
  
  <!-- Líneas internas de la factura (conceptos) -->
  <rect x="32" y="24" width="22" height="4.5" rx="2" fill="#ffffff" fill-opacity="0.85" />
  <rect x="32" y="34" width="26" height="4.5" rx="2" fill="#ffffff" fill-opacity="0.85" />
  <rect x="32" y="44" width="18" height="4.5" rx="2" fill="#ffffff" fill-opacity="0.85" />
  
  <!-- Detalle del rayo interno que corta en la base -->
  <path d="M50 48 L36 64 H44 V76 L58 60 H50 Z" fill="#ffffff" />
</svg>
