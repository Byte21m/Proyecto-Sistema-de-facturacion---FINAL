---
import Logo from './Logo.astro';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: className = '' } = Astro.props;

const sizeClasses = {
  sm: {
    icon: 'w-6 h-6',
    text: 'text-lg'
  },
  md: {
    icon: 'w-8 h-8',
    text: 'text-xl'
  },
  lg: {
    icon: 'w-10 h-10',
    text: 'text-3xl'
  }
};

const currentSize = sizeClasses[size];
---

<div class:list={["flex items-center gap-2 group cursor-pointer select-none", className]}>
  <div class="relative transition-transform duration-300 group-hover:scale-105 group-hover:rotate-1">
    <Logo class={currentSize.icon} />
  </div>
  <span class:list={[
    currentSize.text,
    "font-black tracking-wide bg-linear-to-r from-[#4f46e5] via-[#a855f7] to-[#db2777] bg-clip-text text-transparent"
  ]}>
    SIGO
  </span>
</div>
