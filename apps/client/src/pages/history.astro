---
import AppLayout from '../layout/AppLayout.astro';
---

<AppLayout title="Historial de Ventas | FacturaApp" activePage="history">
  <div class="p-6 md:p-8 w-full max-w-7xl mx-auto flex flex-col gap-6 animate-fade-in">
    <!-- Encabezado y Filtros -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <h1 class="text-3xl md:text-4xl font-black text-gray-900 dark:text-white tracking-tight">Historial de Ventas</h1>
        <p class="text-gray-500 dark:text-gray-400 font-medium mt-1">Revisa el registro detallado de todas las ventas y facturas.</p>
      </div>

      <!-- Pestañas / Filtro -->
      <div class="flex p-1 space-x-1 bg-gray-200/50 dark:bg-gray-800/50 rounded-xl w-max">
        <button id="tab-invoices" class="tab-btn active px-4 py-2 text-sm font-bold rounded-lg transition-all text-indigo-700 bg-white shadow-sm dark:bg-gray-700 dark:text-white">
          Facturas Emitidas
        </button>
        <button id="tab-items" class="tab-btn px-4 py-2 text-sm font-bold rounded-lg transition-all text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300">
          Ventas por Producto
        </button>
      </div>
    </div>

    <!-- Contenedor de Facturas (Invoices) -->
    <div id="view-invoices" class="glass-card rounded-3xl overflow-hidden animate-fade-in">
      <div class="flex flex-col h-[460px] md:h-[500px]">
        <div class="p-6 border-b border-gray-200 dark:border-gray-800 flex justify-between items-center bg-white/50 dark:bg-gray-900/50 flex-shrink-0">
          <h2 class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
            <span class="text-indigo-500">🧾</span> Registro de Facturas
          </h2>
          <div class="loading-indicator hidden">
            <div class="animate-spin rounded-full h-5 w-5 border-b-2 border-indigo-500"></div>
          </div>
        </div>

        <div id="invoices-table-wrapper" class="overflow-auto flex-1 flex flex-col relative">
          <table class="w-full text-left border-collapse">
            <thead class="sticky top-0 z-10 bg-gray-50/95 dark:bg-gray-800/95 backdrop-blur-sm shadow-sm">
              <tr>
                <th class="px-6 py-4 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Factura N°</th>
                <th class="px-6 py-4 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Fecha / Hora</th>
                <th class="px-6 py-4 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Vendedor</th>
                <th class="px-6 py-4 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider text-right">Total Factura</th>
              </tr>
            </thead>
            <tbody id="invoices-table-body" class="divide-y divide-gray-100 dark:divide-gray-800">
              <!-- Renderizado dinámico aquí -->
            </tbody>
          </table>
          
          <div id="invoices-empty-state" class="m-auto p-12 text-center hidden">
            <div class="text-6xl mb-4 opacity-80">📄</div>
            <h3 class="text-lg font-bold text-gray-900 dark:text-white">Sin facturas</h3>
            <p class="text-gray-500 dark:text-gray-400">Aún no se han emitido facturas en el sistema.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Contenedor de Detalles de Venta (Items) -->
    <div id="view-items" class="glass-card rounded-3xl overflow-hidden animate-fade-in hidden">
      <div class="flex flex-col h-[460px] md:h-[500px]">
        <div class="p-6 border-b border-gray-200 dark:border-gray-800 flex justify-between items-center bg-white/50 dark:bg-gray-900/50 flex-shrink-0">
          <h2 class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
            <span class="text-emerald-500">🛍️</span> Productos Vendidos
          </h2>
          <div class="loading-indicator hidden">
            <div class="animate-spin rounded-full h-5 w-5 border-b-2 border-indigo-500"></div>
          </div>
        </div>

        <div id="items-table-wrapper" class="overflow-auto flex-1 flex flex-col relative">
          <table class="w-full text-left border-collapse">
            <thead class="sticky top-0 z-10 bg-gray-50/95 dark:bg-gray-800/95 backdrop-blur-sm shadow-sm">
              <tr>
                <th class="px-6 py-4 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Fecha / Hora</th>
                <th class="px-6 py-4 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Factura N°</th>
                <th class="px-6 py-4 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Producto</th>
                <th class="px-6 py-4 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider text-center">Cantidad</th>
                <th class="px-6 py-4 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider text-right">Precio de Venta</th>
              </tr>
            </thead>
            <tbody id="items-table-body" class="divide-y divide-gray-100 dark:divide-gray-800">
              <!-- Renderizado dinámico aquí -->
            </tbody>
          </table>
          
          <div id="items-empty-state" class="m-auto p-12 text-center hidden">
            <div class="text-6xl mb-4">📈</div>
            <h3 class="text-lg font-bold text-gray-900 dark:text-white">Sin productos vendidos</h3>
            <p class="text-gray-500 dark:text-gray-400">Las ventas de productos detalladas aparecerán aquí.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Invoice Details Drawer (Slide-over) -->
  <div id="invoice-drawer-overlay" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-40 hidden transition-opacity duration-300 opacity-0"></div>
  <div id="invoice-drawer" class="fixed top-0 right-0 h-full w-full max-w-md bg-white dark:bg-gray-900 shadow-2xl z-50 transform translate-x-full transition-transform duration-300 flex flex-col">
    <!-- Header -->
    <div class="px-6 py-5 border-b border-gray-100 dark:border-gray-800 flex items-center justify-between bg-gray-50/50 dark:bg-gray-800/50">
      <div>
        <h3 id="drawer-title" class="text-xl font-extrabold text-gray-900 dark:text-white flex items-center gap-2">
          Factura Detalle
        </h3>
        <p id="drawer-subtitle" class="text-xs text-gray-500 dark:text-gray-400 mt-1">Cargando...</p>
      </div>
      <button id="close-drawer-btn" class="p-2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-full transition-colors">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Content -->
    <div class="flex-1 overflow-y-auto p-6">
      <div id="drawer-loading" class="flex justify-center items-center h-32">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-500"></div>
      </div>
      
      <div id="drawer-content" class="hidden space-y-6">
        <!-- Vendedor Info -->
        <div class="bg-gray-50 dark:bg-gray-800/50 p-4 rounded-2xl">
          <p class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">Vendedor</p>
          <p id="drawer-seller" class="text-sm font-medium text-gray-900 dark:text-white">---</p>
        </div>

        <!-- Items Table -->
        <div>
          <h4 class="text-sm font-bold text-gray-900 dark:text-white mb-3">Productos Adquiridos</h4>
          <div class="border border-gray-100 dark:border-gray-800 rounded-2xl overflow-hidden">
            <table class="w-full text-left text-sm">
              <thead class="bg-gray-50 dark:bg-gray-800/50 text-xs text-gray-500 dark:text-gray-400">
                <tr>
                  <th class="px-4 py-2 font-bold">Item</th>
                  <th class="px-4 py-2 font-bold text-center">Cant.</th>
                  <th class="px-4 py-2 font-bold text-right">Precio</th>
                  <th class="px-4 py-2 font-bold text-right">Subtotal</th>
                </tr>
              </thead>
              <tbody id="drawer-items-body" class="divide-y divide-gray-100 dark:divide-gray-800">
                <!-- Rendered dynamically -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Totals -->
        <div class="border-t border-gray-100 dark:border-gray-800 pt-4 space-y-2">
          <div class="flex justify-between text-sm">
            <span class="text-gray-500 dark:text-gray-400 font-medium">Tasa aplicada</span>
            <span id="drawer-tasa" class="font-bold text-gray-900 dark:text-white">---</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-gray-500 dark:text-gray-400 font-medium">Total USD</span>
            <span id="drawer-total-usd" class="font-bold text-gray-900 dark:text-white">---</span>
          </div>
          <div class="flex justify-between items-center mt-2 pt-2 border-t border-dashed border-gray-200 dark:border-gray-700">
            <span class="text-base font-bold text-gray-900 dark:text-white">TOTAL Bs.</span>
            <span id="drawer-total-bs" class="text-lg font-black text-emerald-600 dark:text-emerald-400">---</span>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Footer actions -->
    <div class="p-6 border-t border-gray-100 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/50 space-y-2">
      <a id="drawer-print-btn" href="#" target="_blank" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-3 rounded-xl font-bold flex items-center justify-center gap-2 transition-all text-sm">
        🖨️ Ver e Imprimir Factura
      </a>
      <div id="drawer-email-section">
        <button id="drawer-email-toggle" class="w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-900 dark:text-white px-4 py-3 rounded-xl font-bold flex items-center justify-center gap-2 transition-all text-sm">
          📧 Enviar por Correo
        </button>
        <form id="drawer-email-form" class="mt-2 hidden gap-2" style="display:none;">
          <input type="email" id="drawer-email-input" required placeholder="correo@ejemplo.com" class="flex-1 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl py-2.5 px-4 text-sm focus:ring-2 focus:ring-indigo-500/50 outline-none text-gray-900 dark:text-white" />
          <button type="submit" id="drawer-email-send" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-xl font-bold text-sm transition-all whitespace-nowrap">Enviar</button>
        </form>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  import inventoryService from '../features/inventory/inventoryService';

  // Elementos de la UI
  const tabInvoices = document.getElementById('tab-invoices');
  const tabItems = document.getElementById('tab-items');
  const viewInvoices = document.getElementById('view-invoices');
  const viewItems = document.getElementById('view-items');

  const invoicesTableBody = document.getElementById('invoices-table-body');
  const itemsTableBody = document.getElementById('items-table-body');
  const invoicesEmptyState = document.getElementById('invoices-empty-state');
  const itemsEmptyState = document.getElementById('items-empty-state');
  const loadingIndicators = document.querySelectorAll('.loading-indicator');

  // Lógica de Tabs
  const switchTab = (showInvoices) => {
    if (showInvoices) {
      tabInvoices.classList.add('text-indigo-700', 'bg-white', 'shadow-sm', 'dark:bg-gray-700', 'dark:text-white');
      tabInvoices.classList.remove('text-gray-500');
      
      tabItems.classList.remove('text-indigo-700', 'bg-white', 'shadow-sm', 'dark:bg-gray-700', 'dark:text-white');
      tabItems.classList.add('text-gray-500');

      viewInvoices.classList.remove('hidden');
      viewItems.classList.add('hidden');
    } else {
      tabItems.classList.add('text-indigo-700', 'bg-white', 'shadow-sm', 'dark:bg-gray-700', 'dark:text-white');
      tabItems.classList.remove('text-gray-500');
      
      tabInvoices.classList.remove('text-indigo-700', 'bg-white', 'shadow-sm', 'dark:bg-gray-700', 'dark:text-white');
      tabInvoices.classList.add('text-gray-500');

      viewItems.classList.remove('hidden');
      viewInvoices.classList.add('hidden');
    }
  };

  tabInvoices.addEventListener('click', () => switchTab(true));
  tabItems.addEventListener('click', () => switchTab(false));

  const toggleLoading = (show) => {
    loadingIndicators.forEach(ind => show ? ind.classList.remove('hidden') : ind.classList.add('hidden'));
  };

  const formatDate = (dateString) => {
    const dateObj = new Date(dateString);
    return {
      date: dateObj.toLocaleDateString(),
      time: dateObj.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
    };
  };

  // Drawer Logic
  const drawerOverlay = document.getElementById('invoice-drawer-overlay');
  const drawer = document.getElementById('invoice-drawer');
  const drawerCloseBtn = document.getElementById('close-drawer-btn');
  
  const drawerLoading = document.getElementById('drawer-loading');
  const drawerContent = document.getElementById('drawer-content');
  const drawerTitle = document.getElementById('drawer-title');
  const drawerSubtitle = document.getElementById('drawer-subtitle');
  const drawerSeller = document.getElementById('drawer-seller');
  const drawerItemsBody = document.getElementById('drawer-items-body');
  const drawerTasa = document.getElementById('drawer-tasa');
  const drawerTotalUsd = document.getElementById('drawer-total-usd');
  const drawerTotalBs = document.getElementById('drawer-total-bs');

  const openDrawer = async (invoiceId) => {
    // UI Open
    drawerOverlay?.classList.remove('hidden');
    drawerOverlay?.classList.add('block');
    setTimeout(() => {
      drawerOverlay?.classList.remove('opacity-0');
      drawer?.classList.remove('translate-x-full');
    }, 10);

    // Reset UI
    drawerLoading?.classList.remove('hidden');
    drawerContent?.classList.add('hidden');
    drawerTitle.textContent = `Factura #${String(invoiceId).padStart(5, '0')}`;
    drawerSubtitle.textContent = 'Cargando detalles...';

    // Fetch Details
    const sale = await inventoryService.getSaleById(invoiceId);
    
    if (sale) {
      drawerLoading?.classList.add('hidden');
      drawerContent?.classList.remove('hidden');

      const { date, time } = formatDate(sale.fecha);
      drawerSubtitle.textContent = `Emitida el ${date} a las ${time}`;
      drawerSeller.textContent = sale.usuario_email || 'Cajero del Sistema';
      
      let usdTotal = 0;
      let firstTasa = 0;

      drawerItemsBody.innerHTML = '';
      if (sale.details && sale.details.length > 0) {
        firstTasa = sale.details[0].tasa_dia || 1;
        sale.details.forEach(item => {
          const qty = item.cantidad;
          const price = parseFloat(item.precio_momento);
          const subtotal = qty * price;
          usdTotal += subtotal;

          const tr = document.createElement('tr');
          tr.className = 'hover:bg-gray-50/50 dark:hover:bg-gray-800/30';
          tr.innerHTML = `
            <td class="px-4 py-2 text-gray-900 dark:text-white font-medium truncate max-w-[150px]">${item.producto_nombre || 'Producto'}</td>
            <td class="px-4 py-2 text-gray-500 dark:text-gray-400 text-center">${qty}</td>
            <td class="px-4 py-2 text-gray-500 dark:text-gray-400 text-right">$${price.toFixed(2)}</td>
            <td class="px-4 py-2 text-gray-900 dark:text-white font-bold text-right">$${subtotal.toFixed(2)}</td>
          `;
          drawerItemsBody.appendChild(tr);
        });
      }

      drawerTasa.textContent = `Bs. ${firstTasa.toFixed(2)}`;
      drawerTotalUsd.textContent = `$${usdTotal.toFixed(2)}`;
      drawerTotalBs.textContent = `Bs. ${parseFloat(sale.total_bs).toFixed(2)}`;
    } else {
      drawerSubtitle.textContent = 'Error al cargar la factura.';
      drawerLoading?.classList.add('hidden');
    }
  };

  const closeDrawer = () => {
    drawerOverlay?.classList.add('opacity-0');
    drawer?.classList.add('translate-x-full');
    setTimeout(() => {
      drawerOverlay?.classList.add('hidden');
      drawerOverlay?.classList.remove('block');
    }, 300);
  };

  drawerCloseBtn?.addEventListener('click', closeDrawer);
  drawerOverlay?.addEventListener('click', closeDrawer);

  const bindInvoiceTriggers = () => {
    document.querySelectorAll('.invoice-trigger').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const invoiceId = e.currentTarget.getAttribute('data-id');
        if (invoiceId) openDrawerWithActions(invoiceId);
      });
    });
  };

  // Carga de datos
  const loadData = async () => {
    toggleLoading(true);

    // Intentamos cargar ambos con reintento si es vacío (por retraso del token)
    let sales = await inventoryService.getSales() || [];
    let historyItems = await inventoryService.getSalesHistory() || [];

    if (sales.length === 0 || historyItems.length === 0) {
      await new Promise(r => setTimeout(r, 1200));
      sales = await inventoryService.getSales() || [];
      historyItems = await inventoryService.getSalesHistory() || [];
    }

    toggleLoading(false);

    // Renderizar Facturas
    invoicesTableBody.innerHTML = '';
    if (sales.length === 0) {
      invoicesEmptyState.classList.remove('hidden');
    } else {
      invoicesEmptyState.classList.add('hidden');
      sales.forEach(sale => {
        const row = document.createElement('tr');
        row.className = 'group hover:bg-gray-50/80 dark:hover:bg-gray-800/40 transition-colors';
        const { date, time } = formatDate(sale.fecha);
        
        row.innerHTML = `
          <td class="px-6 py-4 whitespace-nowrap text-sm font-extrabold text-indigo-600 dark:text-indigo-400">
            <button class="invoice-trigger flex items-center gap-1.5 hover:underline focus:outline-none focus:ring-2 focus:ring-indigo-500/30 rounded-md px-1 -ml-1 transition-all" data-id="${sale.id}">
              #${String(sale.id).padStart(5, '0')}
              <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600 dark:text-gray-400">
            <span class="font-medium text-gray-900 dark:text-white">${date}</span> <span class="text-xs text-gray-400 ml-1">${time}</span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600 dark:text-gray-400">
            ${sale.usuario_email || 'Desconocido'}
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-right">
            <div class="flex flex-col items-end">
              <span class="text-sm font-bold text-emerald-600 dark:text-emerald-400">Bs. ${parseFloat(sale.total_bs).toFixed(2)}</span>
            </div>
          </td>
        `;
        invoicesTableBody.appendChild(row);
      });
    }

    // Renderizar Items Vendidos
    itemsTableBody.innerHTML = '';
    if (historyItems.length === 0) {
      itemsEmptyState.classList.remove('hidden');
    } else {
      itemsEmptyState.classList.add('hidden');
      historyItems.forEach(item => {
        const row = document.createElement('tr');
        row.className = 'group hover:bg-gray-50/80 dark:hover:bg-gray-800/40 transition-colors';
        const { date, time } = formatDate(item.fecha);
        
        // Calcular dólares y bolívares por el item individual
        const priceUSD = parseFloat(item.precio_momento);
        const rateVES = parseFloat(item.tasa_dia || 1);
        const priceVES = priceUSD * rateVES;

        row.innerHTML = `
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600 dark:text-gray-400">
            <span class="font-medium text-gray-900 dark:text-white">${date}</span> <span class="text-xs text-gray-400 ml-1">${time}</span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-xs font-bold text-indigo-500">
            <button class="invoice-trigger flex items-center gap-1.5 hover:underline focus:outline-none focus:ring-2 focus:ring-indigo-500/30 rounded-md px-1 -ml-1 transition-all" data-id="${item.id_factura}">
              #${String(item.id_factura).padStart(5, '0')}
              <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900 dark:text-white">
            ${item.producto_nombre}
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-center">
            <span class="bg-indigo-50 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-400 px-2 py-1 rounded-md text-xs font-bold">${item.cantidad} und.</span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-right">
            <div class="flex flex-col items-end">
              <span class="text-sm font-bold text-gray-900 dark:text-white">$${priceUSD.toFixed(2)}</span>
              <span class="text-xs font-medium text-emerald-600 dark:text-emerald-500">Bs. ${priceVES.toFixed(2)}</span>
            </div>
          </td>
        `;
        itemsTableBody.appendChild(row);
      });
    }

    // Activar los botones de facturas recién renderizados
    bindInvoiceTriggers();
  };

  // ===== Drawer Invoice Actions =====
  let currentDrawerInvoiceId = null;

  const openDrawerWithActions = async (invoiceId) => {
    currentDrawerInvoiceId = invoiceId;
    const printBtn = document.getElementById('drawer-print-btn');
    if (printBtn) printBtn.href = `/invoice-preview?id=${invoiceId}`;
    const emailForm = document.getElementById('drawer-email-form');
    if (emailForm) emailForm.style.display = 'none';
    await openDrawer(invoiceId);
  };

  // Email toggle
  document.getElementById('drawer-email-toggle')?.addEventListener('click', () => {
    const form = document.getElementById('drawer-email-form');
    if (form) {
      const isHidden = form.style.display === 'none' || form.style.display === '';
      form.style.display = isHidden ? 'flex' : 'none';
    }
    document.getElementById('drawer-email-input')?.focus();
  });

  // Email send
  document.getElementById('drawer-email-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('drawer-email-input')?.value;
    const btn = document.getElementById('drawer-email-send');
    if (!email || !currentDrawerInvoiceId) return;
    btn.textContent = 'Enviando...';
    btn.disabled = true;
    const result = await inventoryService.sendInvoiceEmail(currentDrawerInvoiceId, email);
    if (result) {
      const emailFormEl = document.getElementById('drawer-email-form');
      if (emailFormEl) emailFormEl.style.display = 'none';
      document.getElementById('drawer-email-input').value = '';
      alert('✅ Factura enviada exitosamente');
    } else {
      alert('❌ Error al enviar la factura');
    }
    btn.textContent = 'Enviar';
    btn.disabled = false;
  });

  // Iniciar
  loadData();
</script>
