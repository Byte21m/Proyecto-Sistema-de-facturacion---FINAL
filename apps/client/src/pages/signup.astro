---
import Button from '../components/Button.astro';
import Spinner from '../components/Spinner.astro';
import PageLayout from '../layout/PageLayout.astro';
---

<PageLayout title="Registro - FacturacionApp">
  <div class="relative h-full flex justify-center items-center p-4 bg-mesh overflow-hidden">
    <!-- Decoración de fondo -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none opacity-30">
      <div class="absolute -bottom-[10%] -left-[10%] w-[40%] h-[40%] bg-indigo-500 rounded-full blur-[120px]"></div>
      <div class="absolute top-[10%] -right-[10%] w-[40%] h-[40%] bg-pink-500 rounded-full blur-[120px]"></div>
    </div>

    <form
      id="signup-form"
      class="relative z-10 w-full max-w-3xl pt-6 pb-8 px-6 md:pt-8 md:pb-10 md:px-8 rounded-xl glass-card flex flex-col gap-5 md:gap-6 my-auto animate-fade-in"
    >
      <div class="text-center space-y-1">
        <div class="mx-auto w-12 h-12 bg-indigo-600 dark:bg-indigo-500 rounded-xl flex items-center justify-center mb-3 shadow-lg shadow-indigo-500/20">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-100 tracking-tight">Registro</h2>
        <p class="text-xs text-gray-500 dark:text-gray-400 font-medium">Únete a la nueva era de facturación digital</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        <!-- Columna Izquierda: Datos del Usuario (3 campos) -->
        <div class="space-y-3">
          <!-- Nombre completo -->
          <div class="space-y-1">
            <label for="nombre" class="text-xs font-bold text-gray-700 dark:text-gray-300 ml-1">Nombre completo</label>
            <div class="relative group">
              <input
                type="text"
                id="nombre"
                class="w-full bg-white/50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-lg py-3 px-5 pr-12 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all text-sm text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 backdrop-blur-sm"
                placeholder="Tu nombre y apellido"
              />
              <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none">
                <ion-icon id="nombre-check" name="checkmark-circle" class="text-green-500 text-xl hidden drop-shadow-sm"></ion-icon>
                <ion-icon id="nombre-cross" name="close-circle" class="text-red-500 text-xl hidden drop-shadow-sm"></ion-icon>
              </div>
            </div>
            <p id="nombre-error" class="text-[10px] text-red-500 dark:text-red-400 font-semibold px-1 mt-1 hidden"></p>
          </div>

          <!-- Correo electrónico -->
          <div class="space-y-1">
            <label for="email" class="text-xs font-bold text-gray-700 dark:text-gray-300 ml-1">Correo electrónico</label>
            <div class="relative group">
              <input
                type="email"
                id="email"
                class="w-full bg-white/50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-lg py-3 px-5 pr-12 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all text-sm text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 backdrop-blur-sm"
                placeholder="tu@correo.com"
              />
              <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none">
                <ion-icon id="email-check" name="checkmark-circle" class="text-green-500 text-xl hidden drop-shadow-sm"></ion-icon>
                <ion-icon id="email-cross" name="close-circle" class="text-red-500 text-xl hidden drop-shadow-sm"></ion-icon>
              </div>
            </div>
            <p id="email-error" class="text-[10px] text-red-500 dark:text-red-400 font-semibold px-1 mt-1 hidden"></p>
          </div>

          <!-- Contraseña segura -->
          <div class="space-y-1">
            <label for="password" class="text-xs font-bold text-gray-700 dark:text-gray-300 ml-1">Contraseña segura</label>
            <div class="relative group">
              <input
                type="password"
                id="password"
                class="w-full bg-white/50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-lg py-3 px-5 pr-12 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all text-sm text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 backdrop-blur-sm"
                placeholder="••••••••"
              />
              <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none">
                <ion-icon id="password-check" name="checkmark-circle" class="text-green-500 text-xl hidden drop-shadow-sm"></ion-icon>
                <ion-icon id="password-cross" name="close-circle" class="text-red-500 text-xl hidden drop-shadow-sm"></ion-icon>
              </div>
            </div>
            <p id="password-error" class="text-[10px] text-red-500 dark:text-red-400 font-semibold px-1 mt-1 hidden"></p>
            <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 px-1 mt-1 leading-normal">
              8+ caracteres, mayúscula, minúscula y un número.
            </p>
          </div>
        </div>

        <!-- Columna Derecha: Datos de la Empresa y Botón (2 campos + Botón) -->
        <div class="flex flex-col justify-between gap-5 md:gap-6">
          <div class="space-y-3">
            <!-- Nombre de la PYME o Kiosco -->
            <div class="space-y-1">
              <label for="razon_social" class="text-xs font-bold text-gray-700 dark:text-gray-300 ml-1">Nombre de la PYME o Kiosco</label>
              <div class="relative group">
                <input
                  type="text"
                  id="razon_social"
                  class="w-full bg-white/50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-lg py-3 px-5 pr-12 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all text-sm text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 backdrop-blur-sm"
                  placeholder="Ej: Inversiones Pérez C.A."
                />
                <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none">
                  <ion-icon id="razon_social-check" name="checkmark-circle" class="text-green-500 text-xl hidden drop-shadow-sm"></ion-icon>
                  <ion-icon id="razon_social-cross" name="close-circle" class="text-red-500 text-xl hidden drop-shadow-sm"></ion-icon>
                </div>
              </div>
              <p id="razon_social-error" class="text-[10px] text-red-500 dark:text-red-400 font-semibold px-1 mt-1 hidden"></p>
            </div>

            <!-- RIF de la Empresa (Opcional) -->
            <div class="space-y-1">
              <label for="rif" class="text-xs font-bold text-gray-700 dark:text-gray-300 ml-1">RIF de la Empresa (Opcional)</label>
              <div class="relative group">
                <input
                  type="text"
                  id="rif"
                  maxlength="9"
                  class="w-full bg-white/50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-lg py-3 px-5 pr-12 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all text-sm text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 backdrop-blur-sm"
                  placeholder="Ej: 123456789 (solo números)"
                />
                <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none">
                  <ion-icon id="rif-check" name="checkmark-circle" class="text-green-500 text-xl hidden drop-shadow-sm"></ion-icon>
                  <ion-icon id="rif-cross" name="close-circle" class="text-red-500 text-xl hidden drop-shadow-sm"></ion-icon>
                </div>
              </div>
              <p id="rif-error" class="text-[10px] text-red-500 dark:text-red-400 font-semibold px-1 mt-1 hidden"></p>
            </div>
          </div>

          <!-- Botón y Link a Login -->
          <div class="space-y-3 pt-2">
            <button
              type="submit"
              class="group relative w-full bg-indigo-600 py-3.5 rounded-lg text-white font-bold text-sm shadow-xl shadow-indigo-500/20 hover:shadow-indigo-500/40 hover:-translate-y-0.5 active:scale-95 transition-all duration-300 overflow-hidden flex items-center justify-center gap-3"
            >
              <span class="relative z-10">Crear cuenta gratis</span>
              <Spinner color="fill-white" />
              <div class="absolute inset-0 bg-linear-to-r from-indigo-500 to-pink-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </button>

            <p class="text-center text-xs font-semibold text-gray-500 dark:text-gray-400">
              ¿Ya eres usuario? <a href="/login" class="text-indigo-600 dark:text-indigo-400 font-bold hover:underline underline-offset-4">Inicia sesión</a>
            </p>
          </div>
        </div>
      </div>
    </form>
  </div>
</PageLayout>


<script>
  // Validation Regex Variables
  import { z } from 'astro/zod';
  import ky, { HTTPError } from 'ky';
  import { showToast } from '../components/notification/notification';

  const formUserSchema = z.object({
    nombre: z.string()
      .min(2, { message: 'El nombre debe tener al menos 2 caracteres' })
      .regex(/^[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]+$/, { message: 'El nombre solo debe contener letras y espacios' }),
    email: z.string().email({ message: 'Tiene que ser un email válido' }),
    password: z.string().regex(/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$/, {
      message: 'La contraseña debe tener mínimo 8 caracteres, una mayúscula, una minúscula y un número',
    }),
    razon_social: z.string().min(2, { message: 'El nombre de la empresa debe tener al menos 2 caracteres' }),
    rif: z.string().regex(/^\d{9}$/, { message: 'El RIF debe tener exactamente 9 números' }).optional().or(z.literal('')),
  });

  // DOM Elements
  const form = document.querySelector('#signup-form');
  const nombreInput = document.querySelector('#nombre');
  const emailInput = document.querySelector('#email');
  const passwordInput = document.querySelector('#password');
  const razonSocialInput = document.querySelector('#razon_social');
  const rifInput = document.querySelector('#rif');
  const spinner = document.querySelector('#spinner');

  // Reusable validation function
  function validateField(inputElement, success, errorMessage = '') {
    if (!inputElement) return;
    const nextDiv = inputElement.nextElementSibling;
    if (!nextDiv || nextDiv.children.length < 2) return;
    const checkIcon = nextDiv.children[0];
    const crossIcon = nextDiv.children[1];
    const value = inputElement.value;
    const errorEl = document.getElementById(`${inputElement.id}-error`);

    if (value.length === 0) {
      checkIcon.classList.add('hidden');
      crossIcon.classList.add('hidden');
      if (errorEl) {
        errorEl.classList.add('hidden');
        errorEl.textContent = '';
      }
      return;
    }

    if (success) {
      checkIcon.classList.remove('hidden');
      crossIcon.classList.add('hidden');
      if (errorEl) {
        errorEl.classList.add('hidden');
        errorEl.textContent = '';
      }
    } else {
      checkIcon.classList.add('hidden');
      crossIcon.classList.remove('hidden');
      if (errorEl && errorMessage) {
        errorEl.textContent = errorMessage;
        errorEl.classList.remove('hidden');
      }
    }
  }

  nombreInput.addEventListener('input', () => {
    nombreInput.value = nombreInput.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]/g, ''); // Filtrar caracteres no permitidos en tiempo real
    const result = formUserSchema.pick({ nombre: true }).safeParse({ nombre: nombreInput.value });
    const errMsg = result.success ? '' : result.error.errors[0]?.message;
    validateField(nombreInput, result.success, errMsg);
  });

  emailInput.addEventListener('input', () => {
    const result = formUserSchema.pick({ email: true }).safeParse({ email: emailInput.value });
    const errMsg = result.success ? '' : result.error.errors[0]?.message;
    validateField(emailInput, result.success, errMsg);
  });

  passwordInput.addEventListener('input', () => {
    const result = formUserSchema.pick({ password: true }).safeParse({ password: passwordInput.value });
    const errMsg = result.success ? '' : result.error.errors[0]?.message;
    validateField(passwordInput, result.success, errMsg);
  });

  razonSocialInput.addEventListener('input', () => {
    const result = formUserSchema.pick({ razon_social: true }).safeParse({ razon_social: razonSocialInput.value });
    const errMsg = result.success ? '' : result.error.errors[0]?.message;
    validateField(razonSocialInput, result.success, errMsg);
  });

  rifInput.addEventListener('input', () => {
    rifInput.value = rifInput.value.replace(/\D/g, ''); // Filtrar para admitir solo números en tiempo real
    const result = formUserSchema.pick({ rif: true }).safeParse({ rif: rifInput.value });
    const errMsg = result.success ? '' : result.error.errors[0]?.message;
    validateField(rifInput, result.success, errMsg);
  });

  // Submit
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Check if fields are valid before proceeding
    const { success, error } = formUserSchema.safeParse({
      nombre: nombreInput.value,
      email: emailInput.value,
      password: passwordInput.value,
      razon_social: razonSocialInput.value,
      rif: rifInput.value,
    });
    const fieldErrors = error?.flatten().fieldErrors;

    if (success) {
      console.log('Form is valid! Ready to submit.');
      const payload = {
        nombre: nombreInput.value,
        email: emailInput.value,
        password: passwordInput.value,
        razon_social: razonSocialInput.value,
        rif: rifInput.value,
      };
      try {
        spinner?.classList.remove('hidden');
        const response = await ky.post('/api/user', { json: payload }).json();
        showToast({
          type: 'success',
          text: `Usuario creado con éxito! Se ha enviado un correo de verificación a ${response.email}`,
        });
      } catch (error) {
        if (error instanceof HTTPError) {
          const errorData = await error.response.json().catch(() => ({}));
          const errorText = error.data?.error || errorData.error || 'Error al registrar usuario';
          showToast({
            type: 'error',
            text: errorText,
          });
        } else {
          showToast({
            type: 'error',
            text: 'Error de red al intentar registrarse',
          });
        }
      } finally {
        spinner?.classList.add('hidden');
      }
    } else {
      validateField(nombreInput, !fieldErrors?.nombre, fieldErrors?.nombre?.[0]);
      validateField(emailInput, !fieldErrors?.email, fieldErrors?.email?.[0]);
      validateField(passwordInput, !fieldErrors?.password, fieldErrors?.password?.[0]);
      validateField(razonSocialInput, !fieldErrors?.razon_social, fieldErrors?.razon_social?.[0]);
      validateField(rifInput, !fieldErrors?.rif, fieldErrors?.rif?.[0]);
      showToast({
        type: 'error',
        text: 'Por favor corrige los campos con errores antes de continuar.',
      });
    }
  });
</script>
