---
import Button from '../components/Button.astro';
import Spinner from '../components/Spinner.astro';
import PageLayout from '../layout/PageLayout.astro';
---

<PageLayout title="Registro - FacturacionApp">
  <div class="relative h-full flex items-center justify-center p-4 bg-mesh overflow-hidden">
    <!-- Decoración de fondo -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none opacity-30">
      <div class="absolute -bottom-[10%] -left-[10%] w-[40%] h-[40%] bg-indigo-500 rounded-full blur-[120px]"></div>
      <div class="absolute top-[10%] -right-[10%] w-[40%] h-[40%] bg-pink-500 rounded-full blur-[120px]"></div>
    </div>

    <form
      id="signup-form"
      class="relative z-10 w-full max-w-md p-8 md:p-10 rounded-3xl glass-card flex flex-col gap-6 md:gap-8 animate-fade-in"
    >
      <div class="text-center space-y-2">
        <div class="mx-auto w-16 h-16 bg-linear-to-tr from-indigo-600 to-pink-600 rounded-2xl flex items-center justify-center mb-6 shadow-2xl shadow-indigo-500/40 transform rotate-6 hover:rotate-0 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
        </div>
        <h2 class="text-3xl font-black text-gray-900 dark:text-white tracking-tight">Crea tu cuenta</h2>
        <p class="text-gray-500 dark:text-gray-400 font-medium">Únete a la nueva era de facturación digital</p>
      </div>

      <div class="space-y-6">
        <div class="space-y-2">
          <label for="email" class="text-sm font-bold text-gray-700 dark:text-gray-300 ml-1">Correo electrónico</label>
          <div class="relative group">
            <input
              type="email"
              id="email"
              class="w-full bg-white/50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-2xl py-4 px-5 pr-12 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 backdrop-blur-sm"
              placeholder="tu@correo.com"
            />
            <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none">
              <ion-icon id="email-check" name="checkmark-circle" class="text-green-500 text-2xl hidden drop-shadow-sm"></ion-icon>
              <ion-icon id="email-cross" name="close-circle" class="text-red-500 text-2xl hidden drop-shadow-sm"></ion-icon>
            </div>
          </div>
        </div>

        <div class="space-y-2">
          <label for="password" class="text-sm font-bold text-gray-700 dark:text-gray-300 ml-1">Contraseña segura</label>
          <div class="relative group">
            <input
              type="password"
              id="password"
              class="w-full bg-white/50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-2xl py-4 px-5 pr-12 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 backdrop-blur-sm"
              placeholder="••••••••"
            />
            <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none">
              <ion-icon id="password-check" name="checkmark-circle" class="text-green-500 text-2xl hidden drop-shadow-sm"></ion-icon>
              <ion-icon id="password-cross" name="close-circle" class="text-red-500 text-2xl hidden drop-shadow-sm"></ion-icon>
            </div>
          </div>
          <p class="text-[11px] font-semibold text-gray-400 dark:text-gray-500 px-1">
            8+ caracteres, mayúscula, minúscula y un número.
          </p>
        </div>
      </div>

      <button
        type="submit"
        class="group relative w-full bg-indigo-600 py-4 rounded-2xl text-white font-bold text-lg shadow-xl shadow-indigo-500/30 hover:shadow-indigo-500/50 hover:-translate-y-1 active:scale-95 transition-all duration-300 overflow-hidden flex items-center justify-center gap-3"
      >
        <span class="relative z-10">Crear cuenta gratis</span>
        <Spinner color="fill-white" />
        <div class="absolute inset-0 bg-linear-to-r from-indigo-500 to-pink-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
      </button>

      <p class="text-center text-sm font-medium text-gray-500 dark:text-gray-400">
        ¿Ya eres usuario? <a href="/login" class="text-indigo-600 dark:text-indigo-400 font-bold hover:underline underline-offset-4">Inicia sesión</a>
      </p>
    </form>
  </div>
</PageLayout>


<script>
  // Validation Regex Variables
  import { z } from 'astro/zod';
  import ky, { HTTPError } from 'ky';
  import { showToast } from '../components/notification/notification';

  const formUserSchema = z.object({
    email: z.email({ error: 'Tiene que ser un email valido' }),
    password: z.string().regex(/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)[a-zA-Z\d\S]{8,}$/, {
      error: 'Recuerda cumplir los requerimientos de la contraseña',
    }),
  });

  // DOM Elements
  const form = document.querySelector('#signup-form');
  const emailInput = document.querySelector('#email');
  const passwordInput = document.querySelector('#password');
  const spinner = document.querySelector('#spinner');

  // Reusable validation function
  function validateField(inputElement, success) {
    const nextDiv = inputElement.nextElementSibling;
    const checkIcon = nextDiv.children[0];
    const crossIcon = nextDiv.children[1];
    const value = inputElement.value;

    if (value.length === 0) {
      checkIcon.classList.add('hidden');
      crossIcon.classList.add('hidden');
      return;
    }

    if (success) {
      checkIcon.classList.remove('hidden');
      crossIcon.classList.add('hidden');
    } else {
      checkIcon.classList.add('hidden');
      crossIcon.classList.remove('hidden');
    }
  }

  emailInput.addEventListener('input', () => {
    const { success } = formUserSchema.pick({ email: true }).safeParse({ email: emailInput.value });
    validateField(emailInput, success);
  });

  passwordInput.addEventListener('input', () => {
    const { success } = formUserSchema
      .pick({ password: true })
      .safeParse({ password: passwordInput.value });
    console.log(success);

    validateField(passwordInput, success);
  });

  // Submit Placeholder
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Check if both fields are valid before proceeding
    const { success, error } = formUserSchema.safeParse({
      email: emailInput.value,
      password: passwordInput.value,
    });
    const fieldErrors = error?.flatten().fieldErrors;

    if (success) {
      console.log('Form is valid! Ready to submit.');
      const payload = {
        email: emailInput.value,
        password: passwordInput.value,
      };
      try {
        spinner?.classList.remove('hidden');
        const response = await ky.post('/api/user', { json: payload }).json();
        showToast({
          type: 'success',
          text: `Usuario creado con éxito! Se ha enviado un correo de verificación a ${response.email}`,
        });
      } catch (error) {
        if (error instanceof HTTPError) {
          const errorText = error.data.error;
          showToast({
            type: 'error',
            text: errorText,
          });
        }
      } finally {
        spinner?.classList.add('hidden');
      }
    } else {
      validateField(emailInput, !fieldErrors?.email);
      validateField(passwordInput, !fieldErrors?.email);
    }
  });
</script>
