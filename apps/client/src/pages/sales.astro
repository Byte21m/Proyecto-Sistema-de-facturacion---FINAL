---
import AppLayout from '../layout/AppLayout.astro';
import Spinner from '../components/Spinner.astro';
---

<AppLayout title="Punto de Venta - SIGO" activePage="sales">
  <div class="p-6 md:p-8 max-w-7xl mx-auto space-y-6 animate-fade-in">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl md:text-4xl font-black text-gray-900 dark:text-white tracking-tight">Punto de Venta</h1>
        <p class="text-gray-500 dark:text-gray-400 font-medium mt-1">Registra ventas y genera facturas al instante.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
      <!-- Product Selector (Left) -->
      <div class="lg:col-span-2 space-y-4">
        <!-- Search and Quick Add -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl p-4 border border-gray-200/60 dark:border-gray-800/60 shadow-sm flex gap-3">
          <div class="relative flex-1">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              id="product-search"
              placeholder="Buscar productos por nombre..."
              class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl py-3 pl-12 pr-4 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500"
            />
          </div>
          <button id="quick-add-btn" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-3 rounded-xl font-bold flex items-center justify-center gap-2 transition-all shadow-md shadow-indigo-500/20 active:scale-95 shrink-0" title="Añadir Producto Rápido">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            <span class="hidden sm:inline">Nuevo</span>
          </button>
        </div>

        <!-- Products Grid -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200/60 dark:border-gray-800/60 shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200/60 dark:border-gray-800/60 flex items-center justify-between">
            <h2 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
              Productos Disponibles
            </h2>
            <span id="product-count" class="text-xs font-bold text-gray-400 dark:text-gray-500 bg-gray-100 dark:bg-gray-800 px-2.5 py-1 rounded-lg">0</span>
          </div>

          <div class="flex flex-col" style="min-height:380px; max-height:380px;">
            <div id="products-grid" class="flex-1 flex flex-col divide-y divide-gray-100 dark:divide-gray-800 overflow-y-auto">
              <!-- Products rendered dynamically -->
            </div>

            <div id="products-empty" class="flex-1 flex-col items-center justify-center p-12 text-center hidden">
              <div class="text-5xl mb-3">📦</div>
              <p class="text-sm font-bold text-gray-900 dark:text-white">Sin productos</p>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Agrega productos desde el módulo de Inventario.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Cart (Right) -->
      <div class="space-y-3 lg:sticky lg:top-6 w-full lg:col-span-1">
        <!-- Tasa del día -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl p-4 border border-gray-200/60 dark:border-gray-800/60 shadow-sm">
          <div class="flex justify-between items-center mb-2">
            <label for="tasa-input" class="text-sm font-bold text-gray-700 dark:text-gray-300 block">Tasa del día (Bs/$)</label>
            <button id="btn-fetch-bcv" type="button" class="text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 flex items-center gap-1 transition-colors" title="Obtener tasa oficial del BCV">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              Recargar BCV
            </button>
          </div>
          <input
            type="number"
            id="tasa-input"
            step="0.01"
            placeholder="Ej. 36.50"
            class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl py-2 px-3 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 text-lg font-bold"
          />
        </div>

        <!-- Cart Items -->
        <div id="cart-placeholder">
          <div id="cart-container" class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200/60 dark:border-gray-800/60 shadow-sm overflow-hidden flex flex-col h-[320px] transition-all duration-300">
            <div id="cart-internal-header" class="px-4 py-3 border-b border-gray-200/60 dark:border-gray-800/60 flex justify-between items-center">
              <h2 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2">
                <svg class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
                </svg>
                Carrito
                <span id="cart-count" class="ml-auto text-xs font-bold text-gray-400 bg-gray-100 dark:bg-gray-800 px-2 py-0.5 rounded-lg">0</span>
              </h2>
              <button id="btn-expand-cart" class="p-1.5 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
              </button>
            </div>

            <div id="cart-items" class="divide-y divide-gray-100 dark:divide-gray-800 overflow-y-auto flex-1 min-h-0">
              <!-- Cart items rendered dynamically -->
            </div>

            <div id="cart-empty" class="flex-1 flex flex-col items-center justify-center p-8 text-center">
              <div class="text-3xl mb-2">🛒</div>
              <p class="text-xs font-bold text-gray-500 dark:text-gray-400">Carrito vacío</p>
              <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">Haz clic en un producto para agregarlo</p>
            </div>

            <!-- Totals with IVA -->
            <div id="cart-totals" class="hidden border-t border-gray-200/60 dark:border-gray-800/60 p-4 space-y-1.5 bg-gray-50/50 dark:bg-gray-800/30">
              <div class="flex justify-between items-center text-xs">
                <span class="text-gray-500 dark:text-gray-400 font-medium">Base Imponible</span>
                <div class="text-right">
                  <span id="total-base-usd" class="block font-bold text-gray-700 dark:text-gray-300">$0.00</span>
                  <span id="total-base-bs" class="block text-[10px] text-gray-400 dark:text-gray-500 font-medium mt-0.5">Bs 0.00</span>
                </div>
              </div>
              <div id="row-exento" class="flex justify-between items-center text-xs" style="display:none;">
                <span class="text-emerald-600 dark:text-emerald-400 font-medium">Exento</span>
                <div class="text-right">
                  <span id="total-exento-usd" class="block font-bold text-emerald-600 dark:text-emerald-400">$0.00</span>
                  <span id="total-exento-bs" class="block text-[10px] text-emerald-500 dark:text-emerald-500/80 font-medium mt-0.5">Bs 0.00</span>
                </div>
              </div>
              <div class="flex justify-between items-center text-xs">
                <span class="text-gray-500 dark:text-gray-400 font-medium">IVA (16%)</span>
                <div class="text-right">
                  <span id="total-iva-usd" class="block font-bold text-gray-700 dark:text-gray-300">$0.00</span>
                  <span id="total-iva-bs" class="block text-[10px] text-gray-400 dark:text-gray-500 font-medium mt-0.5">Bs 0.00</span>
                </div>
              </div>
              <div class="flex justify-between items-center pt-2 mt-1 border-t border-dashed border-gray-300 dark:border-gray-700">
                <span class="text-sm font-extrabold text-gray-900 dark:text-white">TOTAL</span>
                <div class="text-right">
                  <span id="total-usd" class="block text-sm font-bold text-indigo-600 dark:text-indigo-400">$0.00</span>
                  <span id="total-bs" class="block text-lg font-black text-gray-900 dark:text-white">Bs 0.00</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Client Data (Optional) -->
        <div id="client-placeholder">
          <!-- Button shown in sidebar -->
          <button id="btn-open-client-modal" class="w-full bg-white dark:bg-gray-900 rounded-2xl border border-gray-200/60 dark:border-gray-800/60 p-3 flex justify-between items-center shadow-sm hover:border-indigo-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all group">
            <div class="flex items-center gap-3">
              <div class="p-2 bg-indigo-50 dark:bg-indigo-500/10 rounded-xl text-indigo-600 dark:text-indigo-400">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
              </div>
              <div class="text-left">
                <span class="block text-sm font-bold text-gray-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">Datos del Cliente</span>
                <span id="client-subtitle" class="block text-xs text-gray-500 dark:text-gray-400">Agregar información (Opcional)</span>
              </div>
            </div>
            <div class="w-8 h-8 rounded-full bg-gray-50 dark:bg-gray-800 flex items-center justify-center text-gray-400 group-hover:bg-indigo-100 dark:group-hover:bg-indigo-500/20 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-all">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
            </div>
          </button>

          <!-- Hidden container to move to modal -->
          <div id="client-section" style="display:none;" class="w-full space-y-5">
            <div>
              <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Nombre / Razón Social</label>
              <input type="text" id="client-name" placeholder="Ej. Juan Pérez o Mi Empresa C.A." class="w-full bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl py-3 px-4 focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 outline-none text-gray-900 dark:text-white shadow-sm" />
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Cédula / RIF</label>
              <input type="text" id="client-id" placeholder="Ej. V-12345678 o J-12345678-9" class="w-full bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl py-3 px-4 focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 outline-none text-gray-900 dark:text-white shadow-sm" />
            </div>
            <div class="flex justify-center gap-3 pt-2">
              <button
                type="button"
                id="btn-clear-client"
                class="p-2.5 w-36 rounded-xl bg-slate-600 hover:bg-slate-700 text-white font-bold text-sm transition-all shadow-md shadow-slate-500/20 flex items-center justify-center gap-2"
              >
                🧹 Limpiar Datos
              </button>
              <button
                type="button"
                id="btn-save-client"
                class="p-2.5 w-36 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm transition-all shadow-md shadow-indigo-500/10 flex items-center justify-center gap-2"
              >
                ✅ Aceptar
              </button>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <button
          id="submit-sale"
          disabled
          class="group relative w-full bg-emerald-600 py-3 rounded-2xl text-white font-bold text-lg shadow-xl shadow-emerald-500/30 hover:shadow-emerald-500/50 hover:-translate-y-1 active:scale-95 transition-all duration-300 overflow-hidden disabled:opacity-40 disabled:hover:translate-y-0 disabled:hover:shadow-emerald-500/30 disabled:cursor-not-allowed"
        >
          <span class="relative z-10 flex items-center justify-center gap-2">
            <svg id="submit-sale-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Registrar Venta
            <Spinner color="fill-white" />
          </span>
          <div class="absolute inset-0 bg-linear-to-r from-emerald-500 to-teal-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </button>
      </div>
    </div>
  </div>

  <!-- Expand Modal (Native Dialog) -->
  <dialog id="expand-modal" class="bg-white dark:bg-gray-900 m-auto p-0 backdrop:bg-black/70 backdrop:backdrop-blur-sm w-[95vw] rounded-3xl overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-800">
    <div class="flex flex-col h-full">
      <div class="w-full bg-gray-50 dark:bg-gray-900 flex justify-between items-center px-6 py-4 border-b border-gray-200 dark:border-gray-800">
        <h3 id="expand-modal-title" class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-2"></h3>
        <button id="btn-close-modal" class="p-2 rounded-xl bg-gray-200 dark:bg-gray-800 hover:bg-gray-300 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 transition-colors flex items-center gap-2 font-bold text-sm">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          Cerrar
        </button>
      </div>
      <div id="expand-modal-body" class="w-full flex-1 overflow-hidden flex flex-col p-4 md:p-8 bg-gray-100 dark:bg-black/20">
        <!-- Content moved here dynamically -->
      </div>
    </div>
  </dialog>

  <!-- Post-Sale Success Modal -->
  <div id="success-modal-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm items-center justify-center z-50 p-4 transition-opacity duration-300 opacity-0" style="display:none;">
    <div class="bg-white dark:bg-gray-900 w-full max-w-sm rounded-3xl shadow-2xl overflow-hidden scale-95 transition-transform duration-300" id="success-modal-content">
      <div class="p-8 text-center">
        <div class="w-16 h-16 bg-emerald-100 dark:bg-emerald-500/20 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
        </div>
        <h3 class="text-xl font-extrabold text-gray-900 dark:text-white mb-1">¡Venta Registrada!</h3>
        <p id="success-factura-num" class="text-sm font-bold text-indigo-600 dark:text-indigo-400 mb-1"></p>
        <p id="success-total" class="text-sm text-gray-500 dark:text-gray-400 mb-6"></p>
        <div class="space-y-2">
          <a id="success-print-btn" href="#" target="_blank" class="flex items-center justify-center gap-2 w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl transition-all text-sm">
            🖨️ Ver e Imprimir Factura
          </a>
          <button id="success-close-btn" class="w-full bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 font-bold py-3 rounded-xl transition-all text-sm">
            Cerrar
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Añadir Producto Rápido -->
  <div id="quick-modal-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden items-center justify-center z-50 p-4 transition-opacity duration-300 opacity-0">
    <div class="bg-white dark:bg-gray-900 w-full max-w-md rounded-3xl shadow-2xl overflow-hidden scale-95 transition-transform duration-300" id="quick-modal-content">
      <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-800 flex items-center justify-between bg-gray-50/50 dark:bg-gray-800/50">
        <h3 class="text-xl font-extrabold text-gray-900 dark:text-white flex items-center gap-2">
          <span class="text-indigo-500">✨</span> Registro Rápido
        </h3>
        <button id="quick-close-btn" class="p-2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-full transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <form id="quick-add-form" class="p-6 space-y-5">
        <div>
          <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Nombre del Producto</label>
          <input type="text" id="quick-nombre" required class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 outline-none text-gray-900 dark:text-white" placeholder="Ej. Cable USB-C" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Precio ($)</label>
            <input type="number" id="quick-precio" step="0.01" required class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 outline-none text-gray-900 dark:text-white" placeholder="0.00" />
          </div>
          <div>
            <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Stock Inicial</label>
            <input type="number" id="quick-stock" min="1" value="1" required class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 outline-none text-gray-900 dark:text-white" />
          </div>
        </div>
        
        <div class="pt-2">
          <button type="submit" id="quick-submit-btn" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3.5 rounded-xl transition-all shadow-lg shadow-indigo-500/30 flex justify-center items-center gap-2">
            <span class="relative z-10 flex items-center justify-center gap-2">
              Guardar y Añadir
              <Spinner color="fill-white" />
            </span>
          </button>
        </div>
      </form>
    </div>
  </div>
</AppLayout>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 0.5s ease-out forwards;
  }
</style>

<script>
  import inventoryService, { inventoryStore } from '../features/inventory/inventoryService';
  import { showToast } from '../components/notification/notification';
  import { getPrivateKy } from '../features/auth/auth.service';
  import { HTTPError } from 'ky';

  // ===== State =====
  let cart = []; // { id, nombre, precio_dolar, cantidad, stockMax, exento_iva }
  const IVA_RATE = 0.16;
  let savedClientName = '';
  let savedClientId = '';

  // ===== DOM =====
  const searchInput = document.getElementById('product-search');
  const productsGrid = document.getElementById('products-grid');
  const productsEmpty = document.getElementById('products-empty');
  const productCount = document.getElementById('product-count');
  const cartItems = document.getElementById('cart-items');
  const cartEmpty = document.getElementById('cart-empty');
  const cartTotals = document.getElementById('cart-totals');
  const cartCountEl = document.getElementById('cart-count');
  const totalUsd = document.getElementById('total-usd');
  const totalBs = document.getElementById('total-bs');
  const totalBaseUsd = document.getElementById('total-base-usd');
  const totalBaseBs = document.getElementById('total-base-bs');
  const totalExentoUsd = document.getElementById('total-exento-usd');
  const totalExentoBs = document.getElementById('total-exento-bs');
  const rowExento = document.getElementById('row-exento');
  const totalIvaUsd = document.getElementById('total-iva-usd');
  const totalIvaBs = document.getElementById('total-iva-bs');
  const tasaInput = document.getElementById('tasa-input');
  const submitBtn = document.getElementById('submit-sale');
  const clientName = document.getElementById('client-name');
  const clientId = document.getElementById('client-id');
  const submitSpinner = submitBtn?.querySelector('#spinner');
  const submitIcon = document.getElementById('submit-sale-icon');


  // Quick Add Modal Elements
  const quickAddBtn = document.getElementById('quick-add-btn');
  const quickModalOverlay = document.getElementById('quick-modal-overlay');
  const quickModalContent = document.getElementById('quick-modal-content');
  const quickCloseBtn = document.getElementById('quick-close-btn');
  const quickAddForm = document.getElementById('quick-add-form');

  function renderProducts(filter = '') {
    const products = inventoryStore.get();
    const filtered = filter
      ? products.filter(p => p.nombre.toLowerCase().includes(filter.toLowerCase()))
      : products;

    productsGrid.innerHTML = '';
    productCount.textContent = filtered.length;

    if (filtered.length === 0) {
      if (productsEmpty) {
        productsEmpty.classList.remove('hidden');
        productsEmpty.classList.add('flex');
      }
      productsGrid?.classList.add('hidden');
    } else {
      if (productsEmpty) {
        productsEmpty.classList.add('hidden');
        productsEmpty.classList.remove('flex');
      }
      productsGrid?.classList.remove('hidden');

      filtered.forEach(product => {
        const inCart = cart.find(c => c.id === product.id);
        const remainingStock = product.stock - (inCart?.cantidad || 0);
        const isOutOfStock = remainingStock <= 0;

        const card = document.createElement('div');
        card.className = `flex items-center gap-3 px-5 py-3 transition-all duration-200 cursor-pointer ${
          isOutOfStock
            ? 'opacity-50 cursor-not-allowed'
            : 'hover:bg-indigo-50/50 dark:hover:bg-indigo-500/5'
        }`;

        const exentoBadge = product.exento_iva ? '<span class="text-[9px] font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/10 px-1 py-0.5 rounded ml-1">EXENTO</span>' : '';

        card.innerHTML = `
          <div class="flex-1 min-w-0">
            <p class="text-xs font-bold text-gray-900 dark:text-white truncate">${product.nombre}${exentoBadge}</p>
            <p class="text-[11px] text-gray-500 dark:text-gray-400">$${parseFloat(product.precio_dolar).toFixed(2)} · Stock: ${remainingStock}</p>
          </div>
          <div class="w-6 h-6 rounded-md ${isOutOfStock ? 'bg-gray-200 dark:bg-gray-700' : 'bg-indigo-100 dark:bg-indigo-500/20'} flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5 ${isOutOfStock ? 'text-gray-400' : 'text-indigo-600 dark:text-indigo-400'}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
          </div>
        `;

        if (!isOutOfStock) {
          card.addEventListener('click', () => addToCart(product));
        }

        productsGrid.appendChild(card);
      });
    }
  }

  // ===== Cart Logic =====
  function addToCart(product) {
    const existing = cart.find(c => c.id === product.id);
    if (existing) {
      if (existing.cantidad < product.stock) {
        existing.cantidad++;
      } else {
        showToast({ type: 'error', text: `No hay más stock de "${product.nombre}"` });
        return;
      }
    } else {
      cart.push({
        id: product.id,
        nombre: product.nombre,
        precio_dolar: product.precio_dolar,
        cantidad: 1,
        stockMax: product.stock,
        exento_iva: !!product.exento_iva,
      });
    }
    renderCart();
    renderProducts(searchInput?.value || '');
  }

  function removeFromCart(id) {
    cart = cart.filter(c => c.id !== id);
    renderCart();
    renderProducts(searchInput?.value || '');
  }

  function updateQuantity(id, delta) {
    const item = cart.find(c => c.id === id);
    if (!item) return;
    const newQty = item.cantidad + delta;
    if (newQty <= 0) {
      removeFromCart(id);
      return;
    }
    if (newQty > item.stockMax) {
      showToast({ type: 'error', text: 'Stock insuficiente' });
      return;
    }
    item.cantidad = newQty;
    renderCart();
    renderProducts(searchInput?.value || '');
  }

  function renderCart() {
    cartItems.innerHTML = '';
    cartCountEl.textContent = cart.length;

    if (cart.length === 0) {
      cartEmpty?.classList.remove('hidden');
      cartItems?.classList.add('hidden');
      cartTotals?.classList.add('hidden');
    } else {
      cartEmpty?.classList.add('hidden');
      cartItems?.classList.remove('hidden');
      cartTotals?.classList.remove('hidden');

      cart.forEach(item => {
        const row = document.createElement('div');
        row.className = 'flex items-center gap-3 px-4 py-3';
        row.innerHTML = `
          <div class="flex-1 min-w-0">
            <p class="text-sm font-bold text-gray-900 dark:text-white truncate">${item.nombre}</p>
            <p class="text-xs text-gray-400">$${parseFloat(item.precio_dolar).toFixed(2)} c/u</p>
          </div>
          <div class="flex items-center gap-1">
            <button data-action="minus" data-id="${item.id}" class="w-7 h-7 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 flex items-center justify-center text-sm font-bold text-gray-600 dark:text-gray-300 transition-colors">−</button>
            <span class="w-8 text-center text-sm font-bold text-gray-900 dark:text-white">${item.cantidad}</span>
            <button data-action="plus" data-id="${item.id}" class="w-7 h-7 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 flex items-center justify-center text-sm font-bold text-gray-600 dark:text-gray-300 transition-colors">+</button>
          </div>
          <button data-action="remove" data-id="${item.id}" class="w-7 h-7 rounded-lg hover:bg-red-50 dark:hover:bg-red-500/10 flex items-center justify-center text-red-400 hover:text-red-600 transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
          </button>
        `;
        cartItems.appendChild(row);
      });

      // Event delegation for cart buttons
      cartItems.querySelectorAll('[data-action]').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = parseInt(btn.dataset.id);
          if (btn.dataset.action === 'minus') updateQuantity(id, -1);
          if (btn.dataset.action === 'plus') updateQuantity(id, 1);
          if (btn.dataset.action === 'remove') removeFromCart(id);
        });
      });
    }

    updateTotals();
  }

  function updateTotals() {
    const tasa = parseFloat(tasaInput?.value) || 0;

    // Separar gravados y exentos
    const gravadoUsd = cart.filter(i => !i.exento_iva).reduce((s, i) => s + i.precio_dolar * i.cantidad, 0);
    const exentoUsd = cart.filter(i => i.exento_iva).reduce((s, i) => s + i.precio_dolar * i.cantidad, 0);
    const gravadoBs = gravadoUsd * tasa;
    const exentoBs = exentoUsd * tasa;
    const ivaUsd = gravadoUsd * IVA_RATE;
    const ivaBs = gravadoBs * IVA_RATE;
    const grandTotalUsd = gravadoUsd + exentoUsd + ivaUsd;
    const grandTotalBs = gravadoBs + exentoBs + ivaBs;

    if (totalBaseUsd) totalBaseUsd.textContent = `$${gravadoUsd.toFixed(2)}`;
    if (totalBaseBs) totalBaseBs.textContent = `Bs ${gravadoBs.toFixed(2)}`;
    if (exentoUsd > 0) {
      if (rowExento) rowExento.style.display = 'flex';
      if (totalExentoUsd) totalExentoUsd.textContent = `$${exentoUsd.toFixed(2)}`;
      if (totalExentoBs) totalExentoBs.textContent = `Bs ${exentoBs.toFixed(2)}`;
    } else {
      if (rowExento) rowExento.style.display = 'none';
    }
    if (totalIvaUsd) totalIvaUsd.textContent = `$${ivaUsd.toFixed(2)}`;
    if (totalIvaBs) totalIvaBs.textContent = `Bs ${ivaBs.toFixed(2)}`;
    totalUsd.textContent = `$${grandTotalUsd.toFixed(2)}`;
    totalBs.textContent = `Bs ${grandTotalBs.toFixed(2)}`;

    submitBtn.disabled = cart.length === 0 || tasa <= 0;
  }

  // ===== Events =====
  searchInput?.addEventListener('input', () => renderProducts(searchInput.value));
  tasaInput?.addEventListener('input', updateTotals);

  submitBtn?.addEventListener('click', async () => {
    const tasa = parseFloat(tasaInput?.value) || 0;
    if (cart.length === 0 || tasa <= 0) return;

    const gravadoUsd = cart.filter(i => !i.exento_iva).reduce((s, i) => s + i.precio_dolar * i.cantidad, 0);
    const exentoUsd = cart.filter(i => i.exento_iva).reduce((s, i) => s + i.precio_dolar * i.cantidad, 0);
    const exentoBs = exentoUsd * tasa;
    const ivaBs = gravadoUsd * tasa * IVA_RATE;
    const ivaUsd = gravadoUsd * IVA_RATE;
    const grandTotalBs = (gravadoUsd + exentoUsd) * tasa + ivaBs;
    const grandTotalUsd = gravadoUsd + exentoUsd + ivaUsd;

    const salePayload = {
      subtotal_usd: gravadoUsd,
      monto_exento_bs: exentoBs,
      iva_porcentaje: 16,
      iva_monto_bs: ivaBs,
      total_bs: grandTotalBs,
      nombre_cliente: savedClientName.trim() || undefined,
      cedula_cliente: savedClientId.trim() || undefined,
      tasa_dia: tasa,
      items: cart.map(item => ({
        id_producto: item.id,
        nombre: item.nombre,
        cantidad: item.cantidad,
        precio_momento: item.precio_dolar,
        tasa_dia: tasa,
        exento_iva: !!item.exento_iva,
      })),
    };

    try {
      submitBtn.disabled = true;
      submitIcon?.classList.add('hidden');
      submitSpinner?.classList.remove('hidden');
      const privateKy = getPrivateKy();
      const result = await privateKy.post('/api/sale', { json: salePayload }).json();

      // Show success modal
      const successOverlay = document.getElementById('success-modal-overlay');
      const successContent = document.getElementById('success-modal-content');
      document.getElementById('success-factura-num').textContent = result.numero_factura || '';
      document.getElementById('success-total').textContent = `$${grandTotalUsd.toFixed(2)} — Bs ${grandTotalBs.toFixed(2)}`;
      document.getElementById('success-print-btn').href = `/invoice-preview?id=${result.id}`;

      successOverlay.style.display = 'flex';
      setTimeout(() => {
        successOverlay?.classList.remove('opacity-0');
        successContent?.classList.remove('scale-95');
      }, 10);

      document.getElementById('success-close-btn')?.addEventListener('click', () => {
        successOverlay?.classList.add('opacity-0');
        successContent?.classList.add('scale-95');
        setTimeout(() => {
          successOverlay.style.display = 'none';
        }, 300);
      });

      cart = [];
      savedClientName = '';
      savedClientId = '';
      if (clientName) clientName.value = '';
      if (clientId) clientId.value = '';
      const clientSubtitle = document.getElementById('client-subtitle');
      if (clientSubtitle) clientSubtitle.textContent = 'Agregar información (Opcional)';
      renderCart();
      await inventoryService.loadInventoryFromServer();
      renderProducts(searchInput?.value || '');
    } catch {
      showToast({ type: 'error', text: 'Error al registrar la venta.' });
    } finally {
      submitSpinner?.classList.add('hidden');
      submitIcon?.classList.remove('hidden');
      submitBtn.disabled = false;
      updateTotals();
    }
  });

  // ===== Quick Add Logic =====
  const openQuickModal = () => {
    quickModalOverlay?.classList.remove('hidden');
    quickModalOverlay?.classList.add('flex');
    setTimeout(() => {
      quickModalOverlay?.classList.remove('opacity-0');
      quickModalContent?.classList.remove('scale-95');
      document.getElementById('quick-nombre')?.focus();
    }, 10);
  };

  const closeQuickModal = () => {
    quickModalOverlay?.classList.add('opacity-0');
    quickModalContent?.classList.add('scale-95');
    setTimeout(() => {
      quickModalOverlay?.classList.add('hidden');
      quickModalOverlay?.classList.remove('flex');
      quickAddForm.reset();
    }, 300);
  };

  quickAddBtn?.addEventListener('click', openQuickModal);
  quickCloseBtn?.addEventListener('click', closeQuickModal);

  // ===== Expand / Fullscreen Logic (Native Dialog) =====
  const expandModal = document.getElementById('expand-modal');
  const expandModalBody = document.getElementById('expand-modal-body');
  const expandModalTitle = document.getElementById('expand-modal-title');
  const btnCloseModal = document.getElementById('btn-close-modal');
  
  let currentExpandedId = null;

  function openModal(containerId, title) {
    const container = document.getElementById(containerId);
    if (!container) return;
    
    currentExpandedId = containerId;
    expandModalTitle.innerHTML = title;
    
    // Move to modal body
    expandModalBody.appendChild(container);
    
    // Adjust classes for fullscreen depending on what is being opened
    if (containerId === 'cart-container') {
      document.getElementById('cart-internal-header').style.display = 'none';
      container.classList.remove('h-[320px]');
      container.classList.add('h-full', 'border-0', 'shadow-none', 'bg-transparent');
      expandModal.className = 'bg-white dark:bg-gray-900 m-auto p-0 backdrop:bg-black/70 backdrop:backdrop-blur-sm w-[95vw] md:w-[80vw] h-[90vh] max-w-5xl rounded-3xl overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-800';
    } else if (containerId === 'client-section') {
      container.style.display = 'block'; // Show inputs
      // Smaller modal for client data
      expandModal.className = 'bg-white dark:bg-gray-900 m-auto p-0 backdrop:bg-black/70 backdrop:backdrop-blur-sm w-[95vw] md:w-[30vw] max-w-md rounded-3xl overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-800';
    }
    
    expandModal.showModal();
  }

  function closeModal() {
    if (!currentExpandedId) return;
    const container = document.getElementById(currentExpandedId);
    
    // Move back to placeholder
    const placeholder = document.getElementById(
      currentExpandedId === 'cart-container' ? 'cart-placeholder' : 'client-placeholder'
    );
    placeholder.appendChild(container);
    
    // Restore classes
    if (currentExpandedId === 'cart-container') {
      document.getElementById('cart-internal-header').style.display = '';
      container.classList.add('h-[320px]');
      container.classList.remove('h-full', 'border-0', 'shadow-none', 'bg-transparent');
    } else if (currentExpandedId === 'client-section') {
      container.style.display = 'none'; // Hide inputs back
    }
    
    currentExpandedId = null;
    if (expandModal.open) {
      expandModal.close();
    }
  }

  // Handle native ESC key closure
  expandModal?.addEventListener('close', () => {
    if (currentExpandedId) {
      closeModal();
    }
  });

  btnCloseModal?.addEventListener('click', closeModal);
  
  // Close on backdrop click
  expandModal?.addEventListener('click', (e) => {
    // If clicking exactly on the dialog element (the backdrop), close it
    if (e.target === expandModal) closeModal();
  });

  // Bind cart expand
  const btnExpandCart = document.getElementById('btn-expand-cart');
  if (btnExpandCart) {
    btnExpandCart.addEventListener('click', (e) => {
      e.stopPropagation();
      openModal('cart-container', '🛒 <span class="text-indigo-600 dark:text-indigo-400">Carrito de Compras</span>');
    });
  }

  // Bind client expand
  const btnOpenClientModal = document.getElementById('btn-open-client-modal');
  if (btnOpenClientModal) {
    btnOpenClientModal.addEventListener('click', (e) => {
      e.preventDefault(); 
      e.stopPropagation();
      // Populate inputs with saved client data before opening
      if (clientName) clientName.value = savedClientName;
      if (clientId) clientId.value = savedClientId;
      openModal('client-section', '📋 <span class="text-indigo-600 dark:text-indigo-400">Datos del Cliente</span>');
    });
  }

  // Client modal action buttons
  const btnSaveClient = document.getElementById('btn-save-client');
  const btnClearClient = document.getElementById('btn-clear-client');
  const clientSubtitle = document.getElementById('client-subtitle');

  btnSaveClient?.addEventListener('click', () => {
    savedClientName = clientName?.value?.trim() || '';
    savedClientId = clientId?.value?.trim() || '';
    
    if (clientSubtitle) {
      if (savedClientName) {
        clientSubtitle.textContent = `Cliente: ${savedClientName}`;
      } else if (savedClientId) {
        clientSubtitle.textContent = `C.I./RIF: ${savedClientId}`;
      } else {
        clientSubtitle.textContent = 'Agregar información (Opcional)';
      }
    }
    
    showToast({ type: 'success', text: 'Datos de cliente guardados' });
    closeModal();
  });

  btnClearClient?.addEventListener('click', () => {
    savedClientName = '';
    savedClientId = '';
    if (clientName) clientName.value = '';
    if (clientId) clientId.value = '';
    
    if (clientSubtitle) {
      clientSubtitle.textContent = 'Agregar información (Opcional)';
    }
    
    showToast({ type: 'success', text: 'Datos de cliente restablecidos' });
    closeModal();
  });

  quickAddForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('quick-submit-btn');
    const quickSpinner = btn?.querySelector('#spinner');
    
    if (btn) btn.disabled = true;
    quickSpinner?.classList.remove('hidden');

    const nombre = document.getElementById('quick-nombre').value;
    const precio = document.getElementById('quick-precio').value;
    const stock = document.getElementById('quick-stock').value;

    try {
      await inventoryService.addProduct({
        nombre,
        precio_dolar: parseFloat(precio),
        stock: parseInt(stock, 10)
      });
      
      showToast({ type: 'success', text: 'Producto creado y disponible' });
      closeQuickModal();
      
      // Auto-añadir al carrito después de una breve pausa para que la tienda (store) se actualice
      setTimeout(() => {
        const products = inventoryStore.get();
        const newProd = products.find(p => p.nombre === nombre);
        if (newProd) {
          addToCart(newProd);
        }
      }, 300);
    } catch (err) {
      console.error('Quick Add Error:', err);
      let errorMsg = 'Error al crear el producto';
      if (err instanceof HTTPError) {
        try {
          const errData = await err.response.json();
          if (errData && errData.error) {
            errorMsg = errData.error;
          }
        } catch (e) {
          console.warn('Could not parse error response json', e);
        }
      }
      showToast({ type: 'error', text: errorMsg });
    } finally {
      quickSpinner?.classList.add('hidden');
      if (btn) btn.disabled = false;
    }
  });

  const btnFetchBcv = document.getElementById('btn-fetch-bcv');

  const fetchBcvRate = async (showNotification = false) => {
    try {
      const bcvRes = await fetch('https://ve.dolarapi.com/v1/dolares/oficial');
      if (bcvRes.ok) {
        const bcvData = await bcvRes.json();
        if (bcvData.promedio && tasaInput) {
          tasaInput.value = bcvData.promedio.toFixed(2);
          updateTotals(); // Actualizar el total por si ya había algo en carrito
          if (showNotification) showToast({ type: 'success', text: 'Tasa BCV actualizada exitosamente' });
        }
      }
    } catch {
      if (showNotification) showToast({ type: 'error', text: 'Error al consultar la tasa BCV' });
      console.log('No se pudo obtener la tasa BCV automáticamente');
    }
  };

  btnFetchBcv?.addEventListener('click', () => fetchBcvRate(true));

  // ===== Init: Load products and render =====
  (async () => {
    // Fetch BCV Rate Automatically
    await fetchBcvRate(false);

    // Si la tienda ya tiene items, renderizalos inmediatamente (para la vista rápida del carrito)
    inventoryStore.subscribe(() => {
      renderProducts(searchInput.value);
    });

    await inventoryService.loadInventoryFromServer();
    let products = inventoryStore.get();

    // Si no cargaron, reintentar (la auth puede necesitar tiempo para refrescar el token)
    if (products.length === 0) {
      await new Promise(r => setTimeout(r, 800));
      await inventoryService.loadInventoryFromServer();
    }

    renderProducts();
    renderCart();
  })();
</script>
