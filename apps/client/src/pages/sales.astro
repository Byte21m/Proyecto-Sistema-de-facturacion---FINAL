---
import AppLayout from '../layout/AppLayout.astro';
---

<AppLayout title="Punto de Venta - FacturaApp" activePage="sales">
  <div class="p-6 md:p-8 max-w-7xl mx-auto space-y-6 animate-fade-in">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl md:text-4xl font-black text-gray-900 dark:text-white tracking-tight">Punto de Venta</h1>
        <p class="text-gray-500 dark:text-gray-400 font-medium mt-1">Registra ventas y genera facturas al instante.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Product Selector (Left) -->
      <div class="lg:col-span-2 space-y-4">
        <!-- Search and Quick Add -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl p-4 border border-gray-200/60 dark:border-gray-800/60 shadow-sm flex gap-3">
          <div class="relative flex-1">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              id="product-search"
              placeholder="Buscar productos por nombre..."
              class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl py-3 pl-12 pr-4 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500"
            />
          </div>
          <button id="quick-add-btn" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-3 rounded-xl font-bold flex items-center justify-center gap-2 transition-all shadow-md shadow-indigo-500/20 active:scale-95 shrink-0" title="Añadir Producto Rápido">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            <span class="hidden sm:inline">Nuevo</span>
          </button>
        </div>

        <!-- Products Grid -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200/60 dark:border-gray-800/60 shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200/60 dark:border-gray-800/60 flex items-center justify-between">
            <h2 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
              Productos Disponibles
            </h2>
            <span id="product-count" class="text-xs font-bold text-gray-400 dark:text-gray-500 bg-gray-100 dark:bg-gray-800 px-2.5 py-1 rounded-lg">0</span>
          </div>

          <div id="products-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-4 max-h-[480px] overflow-y-auto">
            <!-- Products rendered dynamically -->
          </div>

          <div id="products-empty" class="p-12 text-center hidden">
            <div class="text-5xl mb-3">📦</div>
            <p class="text-sm font-bold text-gray-900 dark:text-white">Sin productos</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Agrega productos desde el módulo de Inventario.</p>
          </div>
        </div>
      </div>

      <!-- Cart (Right) -->
      <div class="space-y-4">
        <!-- Tasa del día -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl p-5 border border-gray-200/60 dark:border-gray-800/60 shadow-sm">
          <label for="tasa-input" class="text-sm font-bold text-gray-700 dark:text-gray-300 mb-2 block">Tasa del día (Bs/$)</label>
          <input
            type="number"
            id="tasa-input"
            step="0.01"
            placeholder="Ej. 36.50"
            class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl py-3 px-4 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 text-lg font-bold"
          />
        </div>

        <!-- Cart Items -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200/60 dark:border-gray-800/60 shadow-sm overflow-hidden">
          <div class="px-5 py-4 border-b border-gray-200/60 dark:border-gray-800/60">
            <h2 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
              </svg>
              Carrito
              <span id="cart-count" class="ml-auto text-xs font-bold text-gray-400 bg-gray-100 dark:bg-gray-800 px-2 py-0.5 rounded-lg">0</span>
            </h2>
          </div>

          <div id="cart-items" class="divide-y divide-gray-100 dark:divide-gray-800 max-h-[250px] overflow-y-auto">
            <!-- Cart items rendered dynamically -->
          </div>

          <div id="cart-empty" class="p-8 text-center">
            <div class="text-3xl mb-2">🛒</div>
            <p class="text-xs font-bold text-gray-500 dark:text-gray-400">Carrito vacío</p>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">Haz clic en un producto para agregarlo</p>
          </div>

          <!-- Totals -->
          <div id="cart-totals" class="hidden border-t border-gray-200/60 dark:border-gray-800/60 p-5 space-y-2 bg-gray-50/50 dark:bg-gray-800/30">
            <div class="flex justify-between text-sm">
              <span class="text-gray-500 dark:text-gray-400 font-medium">Total ($)</span>
              <span id="total-usd" class="font-bold text-gray-900 dark:text-white">$0.00</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500 dark:text-gray-400 font-medium">Total (Bs)</span>
              <span id="total-bs" class="font-bold text-gray-900 dark:text-white text-lg">Bs 0.00</span>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <button
          id="submit-sale"
          disabled
          class="group relative w-full bg-emerald-600 py-4 rounded-2xl text-white font-bold text-lg shadow-xl shadow-emerald-500/30 hover:shadow-emerald-500/50 hover:-translate-y-1 active:scale-95 transition-all duration-300 overflow-hidden disabled:opacity-40 disabled:hover:translate-y-0 disabled:hover:shadow-emerald-500/30 disabled:cursor-not-allowed"
        >
          <span class="relative z-10 flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Registrar Venta
          </span>
          <div class="absolute inset-0 bg-linear-to-r from-emerald-500 to-teal-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </button>
      </div>
    </div>
  </div>

  <!-- Modal Añadir Producto Rápido -->
  <div id="quick-modal-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden items-center justify-center z-50 p-4 transition-opacity duration-300 opacity-0">
    <div class="bg-white dark:bg-gray-900 w-full max-w-md rounded-3xl shadow-2xl overflow-hidden scale-95 transition-transform duration-300" id="quick-modal-content">
      <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-800 flex items-center justify-between bg-gray-50/50 dark:bg-gray-800/50">
        <h3 class="text-xl font-extrabold text-gray-900 dark:text-white flex items-center gap-2">
          <span class="text-indigo-500">✨</span> Registro Rápido
        </h3>
        <button id="quick-close-btn" class="p-2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-full transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <form id="quick-add-form" class="p-6 space-y-5">
        <div>
          <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Nombre del Producto</label>
          <input type="text" id="quick-nombre" required class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 outline-none text-gray-900 dark:text-white" placeholder="Ej. Cable USB-C" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Precio ($)</label>
            <input type="number" id="quick-precio" step="0.01" required class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 outline-none text-gray-900 dark:text-white" placeholder="0.00" />
          </div>
          <div>
            <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Stock Inicial</label>
            <input type="number" id="quick-stock" min="1" value="1" required class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 outline-none text-gray-900 dark:text-white" />
          </div>
        </div>
        
        <div class="pt-2">
          <button type="submit" id="quick-submit-btn" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3.5 rounded-xl transition-all shadow-lg shadow-indigo-500/30 flex justify-center items-center gap-2">
            Guardar y Añadir
          </button>
        </div>
      </form>
    </div>
  </div>
</AppLayout>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 0.5s ease-out forwards;
  }
</style>

<script>
  import inventoryService, { inventoryStore } from '../features/inventory/inventoryService';
  import { showToast } from '../components/notification/notification';
  import { getPrivateKy } from '../features/auth/auth.service';

  // ===== State =====
  let cart = []; // { id, nombre, precio_dolar, cantidad, stockMax }

  // ===== DOM =====
  const searchInput = document.getElementById('product-search');
  const productsGrid = document.getElementById('products-grid');
  const productsEmpty = document.getElementById('products-empty');
  const productCount = document.getElementById('product-count');
  const cartItems = document.getElementById('cart-items');
  const cartEmpty = document.getElementById('cart-empty');
  const cartTotals = document.getElementById('cart-totals');
  const cartCountEl = document.getElementById('cart-count');
  const totalUsd = document.getElementById('total-usd');
  const totalBs = document.getElementById('total-bs');
  const tasaInput = document.getElementById('tasa-input');
  const submitBtn = document.getElementById('submit-sale');

  // Quick Add Modal Elements
  const quickAddBtn = document.getElementById('quick-add-btn');
  const quickModalOverlay = document.getElementById('quick-modal-overlay');
  const quickModalContent = document.getElementById('quick-modal-content');
  const quickCloseBtn = document.getElementById('quick-close-btn');
  const quickAddForm = document.getElementById('quick-add-form');

  function renderProducts(filter = '') {
    const products = inventoryStore.get();
    const filtered = filter
      ? products.filter(p => p.nombre.toLowerCase().includes(filter.toLowerCase()))
      : products;

    productsGrid.innerHTML = '';
    productCount.textContent = filtered.length;

    if (filtered.length === 0) {
      productsEmpty?.classList.remove('hidden');
      productsGrid?.classList.add('hidden');
    } else {
      productsEmpty?.classList.add('hidden');
      productsGrid?.classList.remove('hidden');

      filtered.forEach(product => {
        const inCart = cart.find(c => c.id === product.id);
        const remainingStock = product.stock - (inCart?.cantidad || 0);
        const isOutOfStock = remainingStock <= 0;

        const card = document.createElement('div');
        card.className = `flex items-center gap-3 p-3 rounded-xl border transition-all duration-200 cursor-pointer ${
          isOutOfStock
            ? 'border-gray-200 dark:border-gray-800 opacity-50 cursor-not-allowed'
            : 'border-gray-200 dark:border-gray-800 hover:border-indigo-300 dark:hover:border-indigo-600 hover:bg-indigo-50/50 dark:hover:bg-indigo-500/5 hover:shadow-sm'
        }`;

        card.innerHTML = `
          <div class="w-10 h-10 rounded-xl bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-lg shrink-0">📦</div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-bold text-gray-900 dark:text-white truncate">${product.nombre}</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">$${parseFloat(product.precio_dolar).toFixed(2)} · Stock: ${remainingStock}</p>
          </div>
          <div class="w-8 h-8 rounded-lg ${isOutOfStock ? 'bg-gray-200 dark:bg-gray-700' : 'bg-indigo-100 dark:bg-indigo-500/20'} flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 ${isOutOfStock ? 'text-gray-400' : 'text-indigo-600 dark:text-indigo-400'}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
          </div>
        `;

        if (!isOutOfStock) {
          card.addEventListener('click', () => addToCart(product));
        }

        productsGrid.appendChild(card);
      });
    }
  }

  // ===== Cart Logic =====
  function addToCart(product) {
    const existing = cart.find(c => c.id === product.id);
    if (existing) {
      if (existing.cantidad < product.stock) {
        existing.cantidad++;
      } else {
        showToast({ type: 'error', text: `No hay más stock de "${product.nombre}"` });
        return;
      }
    } else {
      cart.push({
        id: product.id,
        nombre: product.nombre,
        precio_dolar: product.precio_dolar,
        cantidad: 1,
        stockMax: product.stock,
      });
    }
    renderCart();
    renderProducts(searchInput?.value || '');
  }

  function removeFromCart(id) {
    cart = cart.filter(c => c.id !== id);
    renderCart();
    renderProducts(searchInput?.value || '');
  }

  function updateQuantity(id, delta) {
    const item = cart.find(c => c.id === id);
    if (!item) return;
    const newQty = item.cantidad + delta;
    if (newQty <= 0) {
      removeFromCart(id);
      return;
    }
    if (newQty > item.stockMax) {
      showToast({ type: 'error', text: 'Stock insuficiente' });
      return;
    }
    item.cantidad = newQty;
    renderCart();
    renderProducts(searchInput?.value || '');
  }

  function renderCart() {
    cartItems.innerHTML = '';
    cartCountEl.textContent = cart.length;

    if (cart.length === 0) {
      cartEmpty?.classList.remove('hidden');
      cartTotals?.classList.add('hidden');
    } else {
      cartEmpty?.classList.add('hidden');
      cartTotals?.classList.remove('hidden');

      cart.forEach(item => {
        const row = document.createElement('div');
        row.className = 'flex items-center gap-3 px-4 py-3';
        row.innerHTML = `
          <div class="flex-1 min-w-0">
            <p class="text-sm font-bold text-gray-900 dark:text-white truncate">${item.nombre}</p>
            <p class="text-xs text-gray-400">$${parseFloat(item.precio_dolar).toFixed(2)} c/u</p>
          </div>
          <div class="flex items-center gap-1">
            <button data-action="minus" data-id="${item.id}" class="w-7 h-7 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 flex items-center justify-center text-sm font-bold text-gray-600 dark:text-gray-300 transition-colors">−</button>
            <span class="w-8 text-center text-sm font-bold text-gray-900 dark:text-white">${item.cantidad}</span>
            <button data-action="plus" data-id="${item.id}" class="w-7 h-7 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 flex items-center justify-center text-sm font-bold text-gray-600 dark:text-gray-300 transition-colors">+</button>
          </div>
          <button data-action="remove" data-id="${item.id}" class="w-7 h-7 rounded-lg hover:bg-red-50 dark:hover:bg-red-500/10 flex items-center justify-center text-red-400 hover:text-red-600 transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
          </button>
        `;
        cartItems.appendChild(row);
      });

      // Event delegation for cart buttons
      cartItems.querySelectorAll('[data-action]').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = parseInt(btn.dataset.id);
          if (btn.dataset.action === 'minus') updateQuantity(id, -1);
          if (btn.dataset.action === 'plus') updateQuantity(id, 1);
          if (btn.dataset.action === 'remove') removeFromCart(id);
        });
      });
    }

    updateTotals();
  }

  function updateTotals() {
    const tasa = parseFloat(tasaInput?.value) || 0;
    const usdTotal = cart.reduce((sum, item) => sum + item.precio_dolar * item.cantidad, 0);
    const bsTotal = usdTotal * tasa;

    totalUsd.textContent = `$${usdTotal.toFixed(2)}`;
    totalBs.textContent = `Bs ${bsTotal.toFixed(2)}`;

    submitBtn.disabled = cart.length === 0 || tasa <= 0;
  }

  // ===== Events =====
  searchInput?.addEventListener('input', () => renderProducts(searchInput.value));
  tasaInput?.addEventListener('input', updateTotals);

  submitBtn?.addEventListener('click', async () => {
    const tasa = parseFloat(tasaInput?.value) || 0;
    if (cart.length === 0 || tasa <= 0) return;

    const usdTotal = cart.reduce((sum, item) => sum + item.precio_dolar * item.cantidad, 0);
    const bsTotal = usdTotal * tasa;

    const salePayload = {
      total_bs: bsTotal,
      tasa_dia: tasa,
      items: cart.map(item => ({
        id_producto: item.id,
        cantidad: item.cantidad,
        precio_momento: item.precio_dolar,
        tasa_dia: tasa,
      })),
    };

    try {
      submitBtn.disabled = true;
      const privateKy = getPrivateKy();
      await privateKy.post('/api/sale', { json: salePayload }).json();
      showToast({ type: 'success', text: `¡Venta registrada! Total: Bs ${bsTotal.toFixed(2)}` });
      cart = [];
      renderCart();
      await inventoryService.loadInventoryFromServer();
      renderProducts(searchInput?.value || '');
    } catch {
      showToast({ type: 'error', text: 'Error al registrar la venta.' });
    } finally {
      submitBtn.disabled = false;
      updateTotals();
    }
  });

  // ===== Quick Add Logic =====
  const openQuickModal = () => {
    quickModalOverlay?.classList.remove('hidden');
    quickModalOverlay?.classList.add('flex');
    setTimeout(() => {
      quickModalOverlay?.classList.remove('opacity-0');
      quickModalContent?.classList.remove('scale-95');
      document.getElementById('quick-nombre')?.focus();
    }, 10);
  };

  const closeQuickModal = () => {
    quickModalOverlay?.classList.add('opacity-0');
    quickModalContent?.classList.add('scale-95');
    setTimeout(() => {
      quickModalOverlay?.classList.add('hidden');
      quickModalOverlay?.classList.remove('flex');
      quickAddForm.reset();
    }, 300);
  };

  quickAddBtn?.addEventListener('click', openQuickModal);
  quickCloseBtn?.addEventListener('click', closeQuickModal);

  quickAddForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('quick-submit-btn');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<div class="animate-spin rounded-full h-5 w-5 border-b-2 border-white"></div>';
    btn.disabled = true;

    const nombre = document.getElementById('quick-nombre').value;
    const precio = document.getElementById('quick-precio').value;
    const stock = document.getElementById('quick-stock').value;

    const success = await inventoryService.addProduct({
      nombre,
      precio_dolar: parseFloat(precio),
      stock: parseInt(stock, 10)
    });

    if (success) {
      showToast({ type: 'success', text: 'Producto creado y disponible' });
      closeQuickModal();
      
      // Auto-añadir al carrito después de una breve pausa para que la tienda (store) se actualice
      setTimeout(() => {
        const products = inventoryStore.get();
        const newProd = products.find(p => p.nombre === nombre);
        if (newProd) {
          addToCart(newProd);
        }
      }, 300);
    } else {
      showToast({ type: 'error', text: 'Error al crear el producto (posible duplicado)' });
    }

    btn.innerHTML = originalText;
    btn.disabled = false;
  });

  // ===== Init: Load products and render =====
  (async () => {
    // Si la tienda ya tiene items, renderizalos inmediatamente (para la vista rápida del carrito)
    inventoryStore.subscribe(() => {
      renderProducts(searchInput.value);
    });

    await inventoryService.loadInventoryFromServer();
    let products = inventoryStore.get();

    // Si no cargaron, reintentar (la auth puede necesitar tiempo para refrescar el token)
    if (products.length === 0) {
      await new Promise(r => setTimeout(r, 800));
      await inventoryService.loadInventoryFromServer();
    }

    renderProducts();
    renderCart();
  })();
</script>
