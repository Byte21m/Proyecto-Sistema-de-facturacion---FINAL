---
import AppLayout from '../layout/AppLayout.astro';
import Spinner from '../components/Spinner.astro';
---

<AppLayout title="Configuración | SIGO" activePage="settings">
  <div class="p-6 md:p-8 w-full max-w-3xl mx-auto space-y-6 animate-fade-in">
    <div>
      <h1 class="text-3xl md:text-4xl font-black text-gray-900 dark:text-white tracking-tight">Configuración</h1>
      <p class="text-gray-500 dark:text-gray-400 font-medium mt-1">Configura los datos fiscales de tu comercio para las facturas.</p>
    </div>

    <!-- Business Profile Form -->
    <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200/60 dark:border-gray-800/60 shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200/60 dark:border-gray-800/60 bg-gray-50/50 dark:bg-gray-800/50">
        <h2 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2">
          <span class="text-indigo-500">🏢</span> Perfil del Comercio
        </h2>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Estos datos aparecerán en el encabezado de tus facturas.</p>
      </div>

      <form id="business-form" class="p-6 space-y-5">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Razón Social *</label>
            <input type="text" id="input-razon" required placeholder="Ej. Mi Comercio C.A." class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 outline-none text-gray-900 dark:text-white" />
          </div>
          <div>
            <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">RIF *</label>
            <input type="text" id="input-rif" required placeholder="Ej. J-12345678-9" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 outline-none text-gray-900 dark:text-white" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Dirección Fiscal</label>
          <input type="text" id="input-direccion" placeholder="Ej. Av. Principal, Local 5, Caracas" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 outline-none text-gray-900 dark:text-white" />
        </div>
        <div>
          <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Teléfono de Contacto</label>
          <input type="text" id="input-telefono" placeholder="Ej. 0412-1234567" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 outline-none text-gray-900 dark:text-white" />
        </div>

        <div id="form-message" class="hidden text-sm font-bold p-3 rounded-xl"></div>

        <button type="submit" id="save-btn" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3.5 rounded-xl transition-all shadow-lg shadow-indigo-500/20 flex justify-center items-center gap-2">
          <span class="relative z-10 flex items-center justify-center gap-2">
            <svg id="save-btn-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            Guardar Configuración
            <Spinner color="fill-white" />
          </span>
        </button>
      </form>
    </div>
  </div>
</AppLayout>

<script>
  import inventoryService from '../features/inventory/inventoryService';

  const form = document.getElementById('business-form');
  const razonInput = document.getElementById('input-razon');
  const rifInput = document.getElementById('input-rif');
  const direccionInput = document.getElementById('input-direccion');
  const telefonoInput = document.getElementById('input-telefono');
  const saveBtn = document.getElementById('save-btn');
  const formMessage = document.getElementById('form-message');

  const spinner = saveBtn?.querySelector('#spinner');
  const saveIcon = document.getElementById('save-btn-icon');

  const showMessage = (text, type) => {
    formMessage.textContent = text;
    formMessage.className = `text-sm font-bold p-3 rounded-xl ${type === 'success' ? 'bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400' : 'bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-400'}`;
    formMessage.classList.remove('hidden');
    setTimeout(() => formMessage.classList.add('hidden'), 4000);
  };

  // Load existing profile
  (async () => {
    const profile = await inventoryService.getBusinessProfile();
    if (profile) {
      razonInput.value = profile.razon_social || '';
      rifInput.value = profile.rif || '';
      direccionInput.value = profile.direccion || '';
      telefonoInput.value = profile.telefono || '';
    }
  })();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    saveIcon?.classList.add('hidden');
    spinner?.classList.remove('hidden');

    const result = await inventoryService.updateBusinessProfile({
      razon_social: razonInput.value.trim(),
      rif: rifInput.value.trim(),
      direccion: direccionInput.value.trim(),
      telefono: telefonoInput.value.trim(),
    });

    if (result) {
      showMessage('✅ Perfil comercial guardado exitosamente', 'success');
    } else {
      showMessage('❌ Error al guardar el perfil', 'error');
    }
    saveBtn.disabled = false;
    saveIcon?.classList.remove('hidden');
    spinner?.classList.add('hidden');
  });
</script>
