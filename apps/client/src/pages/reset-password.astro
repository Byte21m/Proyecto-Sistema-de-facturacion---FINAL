---
import PageLayout from '../layout/PageLayout.astro';
import Logo from '../components/Logo.astro';
---

<PageLayout title="Nueva Contraseña - FacturacionApp">
  <div class="relative h-full flex items-center justify-center p-4 bg-mesh overflow-hidden">
    <!-- Decoración de fondo -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none opacity-30">
      <div class="absolute top-[20%] -left-[10%] w-[40%] h-[40%] bg-indigo-500 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-[20%] -right-[10%] w-[40%] h-[40%] bg-indigo-500 rounded-full blur-[120px]"></div>
    </div>

    <form
      id="reset-form"
      class="relative z-10 w-full max-w-md p-8 md:p-10 rounded-3xl glass-card flex-col gap-6 md:gap-8 animate-fade-in hidden"
    >
      <div class="text-center space-y-2">
        <div class="flex items-center justify-center gap-2.5 mb-2">
          <Logo class="w-10 h-10" />
          <span class="text-2xl font-black text-gray-900 dark:text-white tracking-tight">FacturacionApp</span>
        </div>
        <h1 class="text-2xl font-bold text-gray-800 dark:text-gray-200 tracking-tight">Nueva Contraseña</h1>
        <p class="text-gray-500 dark:text-gray-400 font-medium">Elige una contraseña segura y no la compartas.</p>
      </div>

      <div class="space-y-5">
        <div class="space-y-2">
          <label for="password" class="text-sm font-bold text-gray-700 dark:text-gray-300 ml-1">Nueva Contraseña</label>
          <input
            type="password"
            id="password"
            placeholder="••••••••"
            required
            minlength="6"
            class="w-full bg-white/50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-2xl py-4 px-5 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 backdrop-blur-sm"
          />
        </div>

        <div class="space-y-2">
          <label for="confirm-password" class="text-sm font-bold text-gray-700 dark:text-gray-300 ml-1">Confirmar Contraseña</label>
          <input
            type="password"
            id="confirm-password"
            placeholder="••••••••"
            required
            minlength="6"
            class="w-full bg-white/50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-2xl py-4 px-5 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 backdrop-blur-sm"
          />
        </div>
      </div>

      <button
        type="submit"
        id="submit-btn"
        class="group relative w-full bg-indigo-600 py-4 rounded-2xl text-white font-bold text-lg shadow-xl shadow-indigo-500/30 hover:shadow-indigo-500/50 hover:-translate-y-1 active:scale-95 transition-all duration-300 overflow-hidden"
      >
        <span class="relative z-10">Guardar Contraseña</span>
        <div class="absolute inset-0 bg-linear-to-r from-indigo-500 to-purple-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
      </button>
    </form>

    <div id="error-state" class="relative z-10 w-full max-w-md p-8 md:p-10 rounded-3xl glass-card flex-col gap-6 text-center animate-fade-in hidden">
      <div class="mx-auto text-6xl mb-2">⚠️</div>
      <h2 class="text-2xl font-black text-gray-900 dark:text-white">Enlace Inválido</h2>
      <p class="text-gray-500 dark:text-gray-400 font-medium">El enlace de recuperación ha expirado o no es válido. Por tu seguridad, los enlaces duran solo 15 minutos.</p>
      <a href="/forgot-password" class="w-full bg-gray-900 dark:bg-white text-white dark:text-gray-900 py-4 rounded-2xl font-bold text-lg hover:-translate-y-1 active:scale-95 transition-all duration-300">
        Solicitar nuevo enlace
      </a>
    </div>
  </div>
</PageLayout>

<script>
  import ky from 'ky';
  import { showToast } from '../components/notification/notification';

  const resetForm = document.getElementById('reset-form');
  const errorState = document.getElementById('error-state');
  const btn = document.getElementById('submit-btn');

  // Obtener el token de la URL
  const urlParams = new URLSearchParams(window.location.search);
  const token = urlParams.get('token');

  if (!token) {
    errorState?.classList.remove('hidden');
    errorState?.classList.add('flex');
  } else {
    resetForm?.classList.remove('hidden');
    resetForm?.classList.add('flex');
  }

  resetForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const password = document.getElementById('password').value;
    const confirmPassword = document.getElementById('confirm-password').value;

    if (password !== confirmPassword) {
      showToast({ type: 'error', text: 'Las contraseñas no coinciden' });
      return;
    }

    const originalText = btn.innerHTML;
    btn.innerHTML = '<span class="relative z-10"><div class="animate-spin rounded-full h-5 w-5 border-b-2 border-white mx-auto"></div></span>';
    btn.disabled = true;

    try {
      await ky.post('/api/auth/reset-password', { json: { token, password } }).json();
      showToast({ type: 'success', text: 'Contraseña actualizada con éxito' });
      
      // Limpiar URL por seguridad y redirigir
      window.history.replaceState({}, document.title, '/login');
      setTimeout(() => {
        location.assign('/login');
      }, 1500);
    } catch {
      errorState?.classList.remove('hidden');
      errorState?.classList.add('flex');
      resetForm?.classList.add('hidden');
      resetForm?.classList.remove('flex');
      showToast({ type: 'error', text: 'El enlace ha expirado o es inválido' });
    } finally {
      btn.innerHTML = originalText;
      btn.disabled = false;
    }
  });
</script>
