---
import PageLayout from '../layout/PageLayout.astro';
---

<PageLayout title="Recuperar Contraseña - FacturacionApp">
  <div class="relative h-full flex items-center justify-center p-4 bg-mesh overflow-hidden">
    <!-- Decoración de fondo -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none opacity-30">
      <div class="absolute top-[20%] -left-[10%] w-[40%] h-[40%] bg-indigo-500 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-[20%] -right-[10%] w-[40%] h-[40%] bg-purple-500 rounded-full blur-[120px]"></div>
    </div>

    <form
      id="forgot-form"
      class="relative z-10 w-full max-w-md p-8 md:p-10 rounded-3xl glass-card flex flex-col gap-6 md:gap-8 animate-fade-in"
    >
      <div class="text-center space-y-2">
        <div class="mx-auto w-16 h-16 bg-linear-to-tr from-indigo-600 to-purple-600 rounded-2xl flex items-center justify-center mb-6 shadow-2xl shadow-indigo-500/40 transform -rotate-6 hover:rotate-0 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h1 class="text-3xl font-black text-gray-900 dark:text-white tracking-tight">Recuperar Acceso</h1>
        <p class="text-gray-500 dark:text-gray-400 font-medium">Ingresa tu correo para recibir un enlace seguro.</p>
      </div>

      <div class="space-y-5">
        <div class="space-y-2">
          <label for="email" class="text-sm font-bold text-gray-700 dark:text-gray-300 ml-1">Correo Electrónico</label>
          <input
            type="email"
            id="email"
            placeholder="ejemplo@pyme.com"
            required
            class="w-full bg-white/50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-2xl py-4 px-5 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 backdrop-blur-sm"
          />
        </div>
      </div>

      <button
        type="submit"
        id="submit-btn"
        class="group relative w-full bg-indigo-600 py-4 rounded-2xl text-white font-bold text-lg shadow-xl shadow-indigo-500/30 hover:shadow-indigo-500/50 hover:-translate-y-1 active:scale-95 transition-all duration-300 overflow-hidden"
      >
        <span class="relative z-10">Enviar Enlace</span>
        <div class="absolute inset-0 bg-linear-to-r from-indigo-500 to-purple-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
      </button>

      <p class="text-center text-sm font-medium text-gray-500 dark:text-gray-400">
        ¿Recordaste tu clave?
        <a href="/login" class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 hover:underline font-bold transition-colors">Vuelve atrás</a>
      </p>
    </form>
  </div>
</PageLayout>

<script>
  import ky from 'ky';
  import { showToast } from '../components/notification/notification';

  const forgotForm = document.getElementById('forgot-form');
  const btn = document.getElementById('submit-btn');

  forgotForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('email').value;

    const originalText = btn.innerHTML;
    btn.innerHTML = '<span class="relative z-10"><div class="animate-spin rounded-full h-5 w-5 border-b-2 border-white mx-auto"></div></span>';
    btn.disabled = true;

    try {
      await ky.post('/api/auth/forgot-password', { json: { email } });
      // Siempre mostramos éxito por seguridad
      showToast({ type: 'success', text: 'Si el correo existe, te hemos enviado instrucciones.' });
      setTimeout(() => {
        location.assign('/login');
      }, 3000);
    } catch {
      showToast({ type: 'error', text: 'Error de red. Intenta nuevamente.' });
    } finally {
      btn.innerHTML = originalText;
      btn.disabled = false;
    }
  });
</script>
