---
import PageLayout from '../layout/PageLayout.astro';
import Logotipo from '../components/Logotipo.astro';
---

<PageLayout title="Recuperar Contraseña - SIGO">
  <div class="relative h-full flex items-center justify-center p-4 bg-mesh overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none opacity-30 dark:opacity-40">
      <div class="absolute top-[20%] -left-[10%] w-[40%] h-[40%] bg-indigo-500 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-[20%] -right-[10%] w-[40%] h-[40%] bg-purple-500 rounded-full blur-[120px]"></div>
    </div>

    <form
      id="forgot-form"
      class="relative z-10 w-full max-w-md p-8 md:p-10 rounded-3xl glass-card shadow-2xl flex flex-col gap-6 md:gap-8 animate-fade-in"
    >
      <div class="text-center space-y-3">
        <Logotipo size="lg" class="justify-center mb-3" />

        <h1 class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white tracking-tight pt-1">
          ¿Olvidaste tu contraseña?
        </h1>
        <p class="text-gray-500 dark:text-gray-400 font-medium text-sm px-2 leading-relaxed">
          No pasa nada. Ingresa tu correo electrónico y te enviaremos un enlace seguro para restablecerla.
        </p>
      </div>

      <div class="space-y-2">
        <label for="email" class="text-xs md:text-sm font-bold text-gray-700 dark:text-gray-300 ml-1 block">
          Correo Electrónico
        </label>
        <div class="relative group">
          <input
            type="email"
            id="email"
            placeholder="ejemplo@pyme.com"
            required
            class="w-full bg-white/80 dark:bg-gray-800/60 border border-gray-200 dark:border-gray-700 rounded-2xl py-4 px-5 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 transition-all text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 shadow-xs"
          />
        </div>
      </div>

      <button
        type="submit"
        id="submit-btn"
        class="group relative w-full bg-indigo-600 py-4 rounded-2xl text-white font-bold text-base md:text-lg shadow-xl shadow-indigo-500/20 hover:shadow-indigo-500/30 hover:-translate-y-0.5 active:scale-98 transition-all duration-200 overflow-hidden"
      >
        <span class="relative z-10">Enviar Enlace de Recuperación</span>
        <div class="absolute inset-0 bg-linear-to-r from-indigo-500 to-purple-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      </button>

      <p class="text-center text-sm font-medium text-gray-500 dark:text-gray-400 border-t border-gray-100 dark:border-gray-800/60 pt-4">
        ¿Recordaste tu clave?
        <a href="/login" class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 hover:underline font-bold transition-colors ml-1">
          Vuelve al inicio de sesión
        </a>
      </p>
    </form>
  </div>
</PageLayout>

<script>
  import ky from 'ky';
  import { showToast } from '../components/notification/notification';

  const forgotForm = document.getElementById('forgot-form');
  const btn = document.getElementById('submit-btn');

  forgotForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Captura segura de los elementos del DOM
    const emailInput = document.getElementById('email');
    
    if (!emailInput || !btn) {
      showToast({ type: 'error', text: 'Error interno en el formulario. Intenta recargar la página.' });
      return;
    }

    const email = emailInput.value;
    const originalText = btn.innerHTML;

    // Spinner adaptativo de carga
    btn.innerHTML = '<span class="relative z-10 flex items-center justify-center"><div class="animate-spin rounded-full h-5 w-5 border-b-2 border-white"></div></span>';
    btn.disabled = true;

    try {
      await ky.post('/api/auth/forgot-password', { json: { email } });
      showToast({ type: 'success', text: 'Si el correo existe, te hemos enviado instrucciones.' });
      setTimeout(() => {
        location.assign('/login');
      }, 3000);
    } catch {
      showToast({ type: 'error', text: 'Error de red. Intenta nuevamente.' });
    } finally {
      btn.innerHTML = originalText;
      btn.disabled = false;
    }
  });
</script>