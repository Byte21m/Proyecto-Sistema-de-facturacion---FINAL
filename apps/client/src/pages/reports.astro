---
import AppLayout from '../layout/AppLayout.astro';
---

<AppLayout title="Reportes | SIGO" activePage="reports">
  <div class="p-6 md:p-8 w-full max-w-5xl mx-auto space-y-6 animate-fade-in">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <h1 class="text-3xl md:text-4xl font-black text-gray-900 dark:text-white tracking-tight">Reportes</h1>
        <p id="report-description" class="text-gray-500 dark:text-gray-400 font-medium mt-1">Resumen mensual de IVA cobrado, base imponible y ventas exentas.</p>
      </div>
      
      <!-- Toolbar: Tabs + Inputs -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <!-- Selector de Tipo (Tabs) -->
        <div class="flex p-1 space-x-1 bg-gray-200/50 dark:bg-gray-800/50 rounded-xl w-full sm:w-max">
          <button id="tab-day" class="tab-btn px-3 py-1.5 text-xs sm:text-sm font-bold rounded-lg transition-all text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300 w-full sm:w-auto">
            Día
          </button>
          <button id="tab-week" class="tab-btn px-3 py-1.5 text-xs sm:text-sm font-bold rounded-lg transition-all text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300 w-full sm:w-auto">
            Semana
          </button>
          <button id="tab-month" class="tab-btn active px-3 py-1.5 text-xs sm:text-sm font-bold rounded-lg transition-all text-indigo-700 bg-white shadow-sm dark:bg-gray-700 dark:text-white w-full sm:w-auto">
            Mes
          </button>
        </div>

        <!-- Inputs Container -->
        <div class="flex items-center gap-2">
          <!-- Calendario (para Día y Semana) -->
          <input
            type="date"
            id="input-date"
            class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-4 py-2.5 text-sm font-bold text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500/50 outline-none hidden w-[224px]"
          />

          <!-- Selector de Mes/Año (para Mes) -->
          <div id="month-selectors" class="flex items-center gap-2 w-[224px]">
            <select id="select-month" class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-4 py-2.5 text-sm font-bold text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500/50 outline-none flex-1">
              <option value="1">Enero</option><option value="2">Febrero</option><option value="3">Marzo</option>
              <option value="4">Abril</option><option value="5">Mayo</option><option value="6">Junio</option>
              <option value="7">Julio</option><option value="8">Agosto</option><option value="9">Septiembre</option>
              <option value="10">Octubre</option><option value="11">Noviembre</option><option value="12">Diciembre</option>
            </select>
            <div class="relative w-24 shrink-0" id="year-combobox-container">
              <input
                type="text"
                id="input-year"
                maxlength="4"
                pattern="[0-9]{4}"
                inputmode="numeric"
                placeholder="Año"
                autocomplete="off"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-4 py-2.5 text-sm font-bold text-gray-900 dark:text-white w-full focus:ring-2 focus:ring-indigo-500/50 outline-none text-center cursor-pointer"
              />
              <div
                id="year-dropdown"
                class="absolute z-20 left-0 right-0 mt-1 max-h-48 overflow-y-auto bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-lg hidden divide-y divide-gray-100 dark:divide-gray-800"
              >
              </div>
            </div>
          </div>

          <button id="btn-load" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-xl font-bold text-sm transition-all">Consultar</button>
          <button id="btn-print-report" class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 px-4 py-2.5 rounded-xl font-bold text-sm transition-all hidden">🖨️ Imprimir</button>
        </div>
      </div>
    </div>

    <!-- Summary Cards -->
    <div id="summary-cards" class="grid-cols-2 md:grid-cols-4 gap-4" style="display:none;">
      <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200/60 dark:border-gray-800/60 p-5">
        <p class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Base Imponible</p>
        <p id="card-base-bs" class="text-xl font-black text-gray-900 dark:text-white mt-1">Bs 0.00</p>
      </div>
      <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200/60 dark:border-gray-800/60 p-5">
        <p class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Ventas Exentas</p>
        <p id="card-exento-bs" class="text-xl font-black text-emerald-600 dark:text-emerald-400 mt-1">Bs 0.00</p>
      </div>
      <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200/60 dark:border-gray-800/60 p-5">
        <p class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">IVA Cobrado (16%)</p>
        <p id="card-iva-bs" class="text-xl font-black text-indigo-600 dark:text-indigo-400 mt-1">Bs 0.00</p>
      </div>
      <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200/60 dark:border-gray-800/60 p-5">
        <p class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Total Facturado</p>
        <p id="card-total-bs" class="text-xl font-black text-gray-900 dark:text-white mt-1">Bs 0.00</p>
        <p id="card-facturas" class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">0 facturas</p>
      </div>
    </div>

    <!-- Invoices Table -->
    <div id="table-section" class="glass-card rounded-3xl overflow-hidden animate-fade-in hidden">
      <div class="flex flex-col h-[380px] md:h-[420px]">
        <div class="p-6 border-b border-gray-200 dark:border-gray-800 flex justify-between items-center bg-white/50 dark:bg-gray-900/50 shrink-0">
          <h2 id="report-table-title" class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
            <span class="text-indigo-500">📋</span> Detalle de Facturas del Mes
          </h2>
        </div>
        <div class="overflow-auto flex-1 flex flex-col relative">
          <table class="w-full text-left border-collapse">
            <thead class="sticky top-0 z-10 bg-gray-50/95 dark:bg-gray-800/95 backdrop-blur-sm shadow-sm">
              <tr>
                <th class="px-5 py-3 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase">N° Factura</th>
                <th class="px-5 py-3 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase">Fecha / Hora</th>
                <th class="px-5 py-3 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase">Cliente</th>
                <th class="px-5 py-3 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase text-right">Base Imp.</th>
                <th class="px-5 py-3 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase text-right">IVA</th>
                <th class="px-5 py-3 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase text-right">Total Bs</th>
              </tr>
            </thead>
            <tbody id="report-table-body" class="divide-y divide-gray-100 dark:divide-gray-800"></tbody>
          </table>
          
          <div id="report-empty" class="m-auto p-12 text-center hidden">
            <div class="text-5xl mb-3">📭</div>
            <p class="text-sm font-bold text-gray-900 dark:text-white">Sin facturas este mes</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Loading -->
    <div id="loading" class="justify-center py-12" style="display:none;">
      <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-500"></div>
    </div>
  </div>
</AppLayout>

<script>
  import inventoryService from '../features/inventory/inventoryService';

  // State
  let activeTab = 'month'; // 'day' | 'week' | 'month'

  // DOM Elements
  const tabDay = document.getElementById('tab-day');
  const tabWeek = document.getElementById('tab-week');
  const tabMonth = document.getElementById('tab-month');
  const inputDate = document.getElementById('input-date');
  const monthSelectors = document.getElementById('month-selectors');
  const selectMonth = document.getElementById('select-month');
  const inputYear = document.getElementById('input-year');
  const btnLoad = document.getElementById('btn-load');
  const btnPrint = document.getElementById('btn-print-report');
  const summaryCards = document.getElementById('summary-cards');
  const tableSection = document.getElementById('table-section');
  const tableBody = document.getElementById('report-table-body');
  const reportEmpty = document.getElementById('report-empty');
  const loading = document.getElementById('loading');
  const reportDescription = document.getElementById('report-description');
  const tableTitle = document.getElementById('report-table-title');

  // Set current month/year and default date
  const now = new Date();
  
  // Populate custom year dropdown options dynamically
  const currentYear = now.getFullYear();
  const yearDropdown = document.getElementById('year-dropdown');
  const comboboxContainer = document.getElementById('year-combobox-container');

  if (yearDropdown && inputYear) {
    yearDropdown.innerHTML = '';
    for (let y = 2020; y <= currentYear + 10; y++) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'w-full text-center px-3 py-2 text-xs sm:text-sm font-bold text-gray-700 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-300 dark:hover:text-white dark:hover:bg-gray-700/60 transition-colors border-0 cursor-pointer block';
      btn.textContent = String(y);
      btn.dataset.value = String(y);
      
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        inputYear.value = String(y);
        yearDropdown.classList.add('hidden');
        loadReport();
      });
      yearDropdown.appendChild(btn);
    }

    inputYear.value = String(currentYear);

    // Show dropdown on click/focus
    inputYear.addEventListener('click', (e) => {
      e.stopPropagation();
      // Show all options initially
      const buttons = yearDropdown.querySelectorAll('button');
      buttons.forEach(btn => btn.classList.remove('hidden'));
      yearDropdown.classList.remove('hidden');
    });

    inputYear.addEventListener('focus', () => {
      // Show all options initially
      const buttons = yearDropdown.querySelectorAll('button');
      buttons.forEach(btn => btn.classList.remove('hidden'));
      yearDropdown.classList.remove('hidden');
    });

    // Filter dropdown options while typing
    inputYear.addEventListener('input', () => {
      const val = inputYear.value.trim();
      const buttons = yearDropdown.querySelectorAll('button');
      let visibleCount = 0;
      buttons.forEach(btn => {
        if (!val || btn.dataset.value.includes(val)) {
          btn.classList.remove('hidden');
          visibleCount++;
        } else {
          btn.classList.add('hidden');
        }
      });
      if (visibleCount > 0) {
        yearDropdown.classList.remove('hidden');
      } else {
        yearDropdown.classList.add('hidden');
      }
    });

    // Hide dropdown when clicking outside
    document.addEventListener('click', (e) => {
      if (comboboxContainer && !comboboxContainer.contains(e.target)) {
        yearDropdown.classList.add('hidden');
      }
    });
  }

  selectMonth.value = String(now.getMonth() + 1);
  
  const todayStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
  if (inputDate) inputDate.value = todayStr;

  const switchTab = (tab) => {
    activeTab = tab;
    
    // Reset tab active classes
    const tabs = [tabDay, tabWeek, tabMonth];
    tabs.forEach(t => {
      if (t) {
        t.classList.remove('text-indigo-700', 'bg-white', 'shadow-sm', 'dark:bg-gray-700', 'dark:text-white');
        t.classList.add('text-gray-500');
      }
    });

    const activeEl = tab === 'day' ? tabDay : tab === 'week' ? tabWeek : tabMonth;
    if (activeEl) {
      activeEl.classList.add('text-indigo-700', 'bg-white', 'shadow-sm', 'dark:bg-gray-700', 'dark:text-white');
      activeEl.classList.remove('text-gray-500');
    }

    // Show/hide inputs
    if (tab === 'day' || tab === 'week') {
      inputDate?.classList.remove('hidden');
      monthSelectors?.classList.add('hidden');
    } else {
      inputDate?.classList.add('hidden');
      monthSelectors?.classList.remove('hidden');
    }

    // Set descriptions
    if (reportDescription) {
      if (tab === 'day') {
        reportDescription.textContent = 'Resumen diario de IVA cobrado, base imponible y ventas exentas.';
      } else if (tab === 'week') {
        reportDescription.textContent = 'Resumen semanal (Lunes a Domingo) de IVA cobrado, base imponible y ventas exentas.';
      } else {
        reportDescription.textContent = 'Resumen mensual de IVA cobrado, base imponible y ventas exentas.';
      }
    }
  };

  tabDay?.addEventListener('click', () => switchTab('day'));
  tabWeek?.addEventListener('click', () => switchTab('week'));
  tabMonth?.addEventListener('click', () => switchTab('month'));

  const loadReport = async () => {
    loading.style.display = 'flex';
    summaryCards.style.display = 'none';
    tableSection.classList.add('hidden');
    btnPrint.classList.add('hidden');

    let dateParam;
    if (activeTab === 'day' || activeTab === 'week') {
      dateParam = inputDate.value;
      if (!dateParam) {
        alert('Por favor selecciona una fecha');
        loading.style.display = 'none';
        return;
      }
    } else {
      const year = parseInt(inputYear.value) || new Date().getFullYear();
      const month = parseInt(selectMonth.value) || (new Date().getMonth() + 1);
      dateParam = `${year}-${String(month).padStart(2, '0')}-01`;
    }

    const data = await inventoryService.getReport(activeTab, dateParam);
    loading.style.display = 'none';

    if (!data) return;

    const s = data.summary;
    const totalBs = parseFloat(s.total_facturado_bs) || 0;
    const ivaBs = parseFloat(s.total_iva_bs) || 0;
    const exentoBs = parseFloat(s.total_exento_bs) || 0;
    const baseBs = totalBs - ivaBs - exentoBs;

    document.getElementById('card-base-bs').textContent = `Bs ${baseBs.toFixed(2)}`;
    document.getElementById('card-exento-bs').textContent = `Bs ${exentoBs.toFixed(2)}`;
    document.getElementById('card-iva-bs').textContent = `Bs ${ivaBs.toFixed(2)}`;
    document.getElementById('card-total-bs').textContent = `Bs ${totalBs.toFixed(2)}`;
    document.getElementById('card-facturas').textContent = `${s.total_facturas} factura(s)`;

    // Update table header text and empty state text
    const emptyStateText = document.querySelector('#report-empty p');
    if (emptyStateText) {
      emptyStateText.textContent = `Sin facturas para este ${activeTab === 'day' ? 'día' : activeTab === 'week' ? 'semana' : 'mes'}`;
    }

    if (tableTitle) {
      if (activeTab === 'day') {
        const [yr, mo, dy] = dateParam.split('-');
        tableTitle.innerHTML = `<span class="text-indigo-500">📋</span> Detalle de Facturas del Día (${dy}/${mo}/${yr})`;
      } else if (activeTab === 'week') {
        const [yr, mo, dy] = dateParam.split('-').map(Number);
        const chosen = new Date(yr, mo - 1, dy);
        const day = chosen.getDay();
        const diffToMonday = chosen.getDate() - day + (day === 0 ? -6 : 1);
        const monday = new Date(chosen.setDate(diffToMonday));
        const sunday = new Date(monday);
        sunday.setDate(monday.getDate() + 6);
        
        const monStr = `${String(monday.getDate()).padStart(2, '0')}/${String(monday.getMonth() + 1).padStart(2, '0')}/${monday.getFullYear()}`;
        const sunStr = `${String(sunday.getDate()).padStart(2, '0')}/${String(sunday.getMonth() + 1).padStart(2, '0')}/${sunday.getFullYear()}`;
        tableTitle.innerHTML = `<span class="text-indigo-500">📋</span> Detalle de Facturas de la Semana (${monStr} al ${sunStr})`;
      } else {
        const monthText = selectMonth.options[selectMonth.selectedIndex]?.text || '';
        tableTitle.innerHTML = `<span class="text-indigo-500">📋</span> Detalle de Facturas de ${monthText} ${inputYear.value}`;
      }
    }

    summaryCards.style.display = 'grid';
    tableSection.classList.remove('hidden');
    btnPrint.classList.remove('hidden');

    // Render table
    tableBody.innerHTML = '';
    if (data.facturas.length === 0) {
      reportEmpty.classList.remove('hidden');
    } else {
      reportEmpty.classList.add('hidden');
      data.facturas.forEach(f => {
        const fechaObj = new Date(f.fecha);
        const fechaStr = fechaObj.toLocaleDateString();
        const horaStr = fechaObj.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        const fBaseBs = parseFloat(f.total_bs) - parseFloat(f.iva_monto_bs) - parseFloat(f.monto_exento_bs);
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-gray-50/80 dark:hover:bg-gray-800/40 transition-colors';
        tr.innerHTML = `
          <td class="px-5 py-3 text-sm font-bold text-indigo-600 dark:text-indigo-400">${f.numero_factura || '—'}</td>
          <td class="px-5 py-3 text-sm text-gray-600 dark:text-gray-400"><span class="font-medium text-gray-900 dark:text-white">${fechaStr}</span> <span class="text-xs text-gray-400">${horaStr}</span></td>
          <td class="px-5 py-3 text-sm text-gray-600 dark:text-gray-400">${f.nombre_cliente || 'Cliente de paso'}</td>
          <td class="px-5 py-3 text-sm text-right text-gray-700 dark:text-gray-300 font-medium">Bs ${fBaseBs.toFixed(2)}</td>
          <td class="px-5 py-3 text-sm text-right text-indigo-600 dark:text-indigo-400 font-bold">Bs ${parseFloat(f.iva_monto_bs).toFixed(2)}</td>
          <td class="px-5 py-3 text-sm text-right font-bold text-gray-900 dark:text-white">Bs ${parseFloat(f.total_bs).toFixed(2)}</td>
        `;
        tableBody.appendChild(tr);
      });
    }
  };

  btnLoad?.addEventListener('click', loadReport);
  btnPrint?.addEventListener('click', () => window.print());

  // Auto-load current month
  loadReport();
</script>
