---
import ProductItem from './ProductItem.astro';
---

<div class="flex flex-col gap-6">
  <!-- Listado Principal -->
  <div class="glass-card rounded-3xl overflow-hidden animate-fade-in flex flex-col h-[460px] md:h-[600px]">
    <div class="p-6 border-b border-gray-200 dark:border-gray-800 flex justify-between items-center bg-white/50 dark:bg-gray-900/50 shrink-0">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
        <span class="text-indigo-500">📋</span> Listado de Productos
      </h2>
      <div id="loading-indicator" class="hidden">
        <div class="animate-spin rounded-full h-5 w-5 border-b-2 border-indigo-500"></div>
      </div>
    </div>

    <div class="overflow-auto flex-1 flex flex-col relative">
      <table class="w-full text-left border-collapse">
        <thead class="sticky top-0 z-10 bg-gray-50/95 dark:bg-gray-800/95 backdrop-blur-sm shadow-sm">
          <tr>
            <th class="px-6 py-4 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Producto</th>
            <th class="px-6 py-4 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Precio ($)</th>
            <th class="px-6 py-4 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Stock</th>
            <th class="px-6 py-4 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider text-right">Acciones</th>
          </tr>
        </thead>
        <tbody id="inventory-table-body" class="divide-y divide-gray-100 dark:divide-gray-800">
          <!-- Renderizado dinámico aquí -->
        </tbody>
      </table>
      
      <div id="empty-state" class="m-auto p-12 text-center hidden">
        <div class="text-6xl mb-4">🧊</div>
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Inventario vacío</h3>
        <p class="text-gray-500 dark:text-gray-400">Comienza añadiendo productos al sistema.</p>
      </div>
    </div>
  </div>
</div>

<ProductItem />

<style>
  /* Dark mode border overrides */
  :global(.dark) .glass-card {
    border-color: rgba(15, 23, 42, 0.8) !important;
  }
  
  :global(.dark) .p-6.border-b {
    border-bottom-color: rgba(15, 23, 42, 0.8) !important;
  }

  :global(.dark) thead {
    box-shadow: none !important;
    border-bottom: 1px solid rgba(15, 23, 42, 0.8) !important;
  }

  :global(.dark) #inventory-table-body tr {
    border-top-color: rgba(15, 23, 42, 0.5) !important;
  }
</style>

<script>
  import inventoryService, { inventoryStore } from './inventoryService';
  import { showToast } from '../../components/notification/notification';

  const tableBody = document.querySelector('#inventory-table-body');
  const template = document.querySelector('#template-product-item');
  const emptyState = document.querySelector('#empty-state');
  const loadingIndicator = document.querySelector('#loading-indicator');

  inventoryStore.listen((products) => {
    tableBody.innerHTML = '';
    
    if (products.length === 0) {
      emptyState.classList.remove('hidden');
    } else {
      emptyState.classList.add('hidden');

      products.forEach((product) => {
        const row = template.content.cloneNode(true).children[0];
        
        // Asignar datos en vista normal
        const nombreText = row.querySelector('.product-name');
        const precioText = row.querySelector('.product-price');
        const stockText = row.querySelector('.product-stock');
        const deleteBtn = row.querySelector('.delete-btn');
        const editBtn = row.querySelector('.edit-btn');

        // Inputs de edición
        const editNombre = row.querySelector('.edit-nombre');
        const editPrecio = row.querySelector('.edit-precio');
        const editStock = row.querySelector('.edit-stock');
        const editExento = row.querySelector('.edit-exento');
        const saveBtn = row.querySelector('.save-btn');
        const cancelBtn = row.querySelector('.cancel-btn');

        // Elementos de vista y edición
        const viewCells = row.querySelectorAll('.view-mode');
        const editCells = row.querySelectorAll('.edit-mode');

        // Renderizado seguro del nombre con insignias
        const safeName = document.createElement('span');
        safeName.textContent = product.nombre;
        nombreText.innerHTML = '';
        nombreText.appendChild(safeName);

        if (product.exento_iva) {
          const badge = document.createElement('span');
          badge.className = 'ml-2 px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 uppercase';
          badge.textContent = 'Exento';
          nombreText.appendChild(badge);
        }

        if (product.tiene_ventas) {
          const badge = document.createElement('span');
          badge.className = 'ml-2 px-2 py-0.5 rounded-md text-[10px] font-bold bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-400 uppercase';
          badge.textContent = 'Vendido';
          nombreText.appendChild(badge);
        }

        precioText.textContent = `$${parseFloat(product.precio_dolar).toFixed(2)}`;
        stockText.textContent = product.stock;

        // Estilo según stock
        if (product.stock <= 5) {
          stockText.classList.add('text-amber-500', 'font-bold');
        }

        // ===== EDITAR =====
        editBtn.addEventListener('click', () => {
          editNombre.value = product.nombre;
          editPrecio.value = product.precio_dolar;
          editStock.value = product.stock;
          if (editExento) {
            editExento.checked = !!product.exento_iva;
          }

          viewCells.forEach(cell => cell.classList.add('hidden'));
          editCells.forEach(cell => cell.classList.remove('hidden'));
          editNombre.focus();
        });

        // ===== GUARDAR =====
        saveBtn.addEventListener('click', async () => {
          const nombre = editNombre.value.trim();
          const precio_dolar = parseFloat(editPrecio.value);
          const stock = parseInt(editStock.value);
          const exento_iva = editExento ? editExento.checked : false;

          if (!nombre) {
            showToast({ text: 'El nombre no puede estar vacío', type: 'error' });
            return;
          }
          if (isNaN(precio_dolar) || precio_dolar <= 0) {
            showToast({ text: 'El precio debe ser mayor a 0', type: 'error' });
            return;
          }
          if (isNaN(stock) || stock < 0) {
            showToast({ text: 'El stock no puede ser negativo', type: 'error' });
            return;
          }

          try {
            saveBtn.disabled = true;
            await inventoryService.updateProduct(product.id, { nombre, precio_dolar, stock, exento_iva });
            showToast({ text: `"${nombre}" actualizado correctamente`, type: 'success' });
          } catch {
            showToast({ text: 'Error al actualizar producto', type: 'error' });
          } finally {
            saveBtn.disabled = false;
          }
        });

        // ===== CANCELAR =====
        cancelBtn.addEventListener('click', () => {
          viewCells.forEach(cell => cell.classList.remove('hidden'));
          editCells.forEach(cell => cell.classList.add('hidden'));
        });

        // ===== ELIMINAR =====
        deleteBtn.addEventListener('click', async () => {
          if (confirm(`¿Eliminar "${product.nombre}"?`)) {
            try {
              await inventoryService.deleteProduct(product.id);
              showToast({ text: `"${product.nombre}" eliminado`, type: 'success' });
            } catch (err) {
              const msg = err?.response ? await err.response.json().then(d => d.error).catch(() => '') : '';
              showToast({ text: msg || 'No se pudo eliminar el producto', type: 'error' });
            }
          }
        });

        tableBody.appendChild(row);
      });
    }
  });

  // Carga inicial
  loadingIndicator.classList.remove('hidden');
  inventoryService.loadInventoryFromServer().finally(() => {
    loadingIndicator.classList.add('hidden');
  });
</script>
