<template id="template-product-item">
  <tr class="group hover:bg-gray-50/80 dark:hover:bg-gray-800/40 transition-colors">
    <td class="px-6 py-4 whitespace-nowrap">
      <div class="flex items-center">
        <div class="product-name text-sm font-bold text-gray-900 dark:text-white"></div>
      </div>
    </td>
    <td class="px-6 py-4 whitespace-nowrap">
      <div class="product-price text-sm font-medium text-gray-600 dark:text-gray-400"></div>
    </td>
    <td class="px-6 py-4 whitespace-nowrap">
      <div class="product-stock text-sm font-medium text-gray-600 dark:text-gray-400"></div>
    </td>
    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
      <div class="flex justify-end gap-2">
        <button class="edit-btn p-2 rounded-lg text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 transition-all">
          <ion-icon name="create-outline" class="text-xl"></ion-icon>
        </button>
        <button class="delete-btn p-2 rounded-lg text-gray-400 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-900/30 transition-all">
          <ion-icon name="trash-outline" class="text-xl"></ion-icon>
        </button>
      </div>
    </td>
  </tr>
</template>
