<template id="template-product-item">
  <tr class="group hover:bg-gray-50/80 dark:hover:bg-gray-800/40 transition-colors">
    <!-- Vista normal -->
    <td class="px-6 py-4 whitespace-nowrap view-mode">
      <div class="flex items-center">
        <div class="product-name text-sm font-bold text-gray-900 dark:text-white"></div>
      </div>
    </td>
    <td class="px-6 py-4 whitespace-nowrap view-mode">
      <div class="product-price text-sm font-medium text-gray-600 dark:text-gray-400"></div>
    </td>
    <td class="px-6 py-4 whitespace-nowrap view-mode">
      <div class="product-stock text-sm font-medium text-gray-600 dark:text-gray-400"></div>
    </td>
    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium view-mode">
      <div class="flex justify-end gap-2">
        <button class="edit-btn p-2 rounded-lg text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 transition-all" title="Editar producto">
          <ion-icon name="create-outline" class="text-xl"></ion-icon>
        </button>
        <button class="delete-btn p-2 rounded-lg text-gray-400 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-900/30 transition-all" title="Eliminar producto">
          <ion-icon name="trash-outline" class="text-xl"></ion-icon>
        </button>
      </div>
    </td>

    <!-- Vista edición (oculta por defecto) -->
    <td class="px-6 py-4 whitespace-nowrap edit-mode hidden" colspan="1">
      <div class="flex flex-col gap-2">
        <input type="text" class="edit-nombre w-full bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-xl py-2 px-3 text-sm text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all" />
        <label class="flex items-center gap-2 text-xs font-bold text-gray-600 dark:text-gray-400 cursor-pointer select-none ml-1">
          <input type="checkbox" class="edit-exento w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500/50 cursor-pointer" />
          Exento de IVA
        </label>
      </div>
    </td>
    <td class="px-6 py-4 whitespace-nowrap edit-mode hidden" colspan="1">
      <input type="number" step="0.01" class="edit-precio w-full bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-xl py-2 px-3 text-sm text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all" />
    </td>
    <td class="px-6 py-4 whitespace-nowrap edit-mode hidden" colspan="1">
      <input type="number" class="edit-stock w-full bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-xl py-2 px-3 text-sm text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all" />
    </td>
    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium edit-mode hidden" colspan="1">
      <div class="flex justify-end gap-2">
        <button class="save-btn p-2 rounded-lg text-emerald-500 hover:text-emerald-600 hover:bg-emerald-50 dark:hover:bg-emerald-900/30 transition-all" title="Guardar cambios">
          <ion-icon name="checkmark-outline" class="text-xl"></ion-icon>
        </button>
        <button class="cancel-btn p-2 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:bg-gray-800 transition-all" title="Cancelar">
          <ion-icon name="close-outline" class="text-xl"></ion-icon>
        </button>
      </div>
    </td>
  </tr>
</template>
